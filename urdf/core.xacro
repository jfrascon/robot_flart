<?xml version="1.0"?>
<!--
The word 'flart' is obtained from the combination of the words 'forklift' and 'artisteril', being 'artisteril' the
company that manufactures the forklift robot.
(f)ork(l)ift + (art)isteril -> flart
This xacro file defines the 'core' version of the flart robot, just the rectangular base with 3 steerable wheels and a
a forklift. No sensors or extra elements are included.
-->
<robot name="flart_core" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="robot_flart_pkg_dir"              value="$(find robot_flart)"/>
  <xacro:property name="eut_robotics_description_pkg_dir" value="$(find eut_robotics_description)"/>

  <!-- ===================================================================== -->
  <!-- INCLUDES -->
  <!-- ===================================================================== -->

  <xacro:include filename="${eut_robotics_description_pkg_dir}/urdf/common/all_commons.xacro"/>
  <xacro:include filename="${eut_robotics_description_pkg_dir}/urdf/wheels/steerable_wheel_macro.xacro"/>
  <xacro:include filename="${eut_robotics_description_pkg_dir}/urdf/extras/fork_macro.xacro"/>

  <!-- ===================================================================== -->
  <!-- ARGS -->
  <!-- ===================================================================== -->
  <!--
  When the xacro file is used in a real deployment, use_sim_mode should be set to False, so no simulation
  plugins are loaded.
  When the xacro file is used in simulation, use_sim_mode should be set to True, so the simulation plugins are loaded.
  -->
  <xacro:arg name="use_sim_mode"           default="False"/>
  <xacro:arg name="namespace"              default=""/>
  <xacro:arg name="robot_name"             default="flart"/>
  <!--
  File containing the simulation configuration for the platform.
  base = body + wheels.
  platform = base + fork.
  -->
  <xacro:arg name="core_sim_file"          default="${robot_flart_pkg_dir}/config/example_flart_core_simulation.yaml"/>

  <xacro:arg name="body_use_visual"        default="True"/>
  <xacro:arg name="body_use_collision"     default="True"/>
  <xacro:arg name="body_use_inertial"      default="True"/>

  <xacro:arg name="body_use_v_mesh"        default="True"/>
  <xacro:arg name="body_use_c_mesh"        default="False"/> <!-- use basic geometry instead by default -->

  <xacro:arg name="st_wheel_use_visual"    default="True"/>
  <!-- Wheels always use collision elements. Read the steerable_wheel macro for more details. -->
  <xacro:arg name="st_wheel_use_inertial"  default="True"/>

  <xacro:arg name="st_wheel_use_v_mesh"    default="False"/> <!-- use basic geometry instead by default -->

  <xacro:arg name="fork_use_visual"        default="True"/>
  <xacro:arg name="fork_use_collision"     default="True"/>
  <!--
  Usually, forks are attached to the robot, on the front or the back side. The fork usually is a heavy body.
  Attaching the fork with a considerable mass to the robot base, will affect the robot's center of mass, which will
  affect the robot's dynamics and stability in simulation, producing oscillations or even making the robot to tip over.
  Since we use simulation to have a kinematic simulation not a dynamic simulation, we can ignore the inertia  of the
  fork, so even though it is attached to the robot, the robot will move as it has no fork attached.
  -->
  <xacro:arg name="fork_use_inertial"      default="False"/>

  <xacro:arg name="fork_use_v_mesh"        default="True"/>
  <xacro:arg name="fork_use_c_mesh"        default="False"/> <!-- use basic geometry instead by default -->

  <!-- ===================================================================== -->
  <!-- DEFINITION OF PROPERTIES -->
  <!-- ===================================================================== -->

  <!-- Create properties from args for easy manipulation. -->

  <xacro:property name="use_sim_mode" value="$(arg use_sim_mode)"/>
  <xacro:property name="namespace"    value="$(arg namespace)"/>
  <xacro:property name="robot_name"   value="$(arg robot_name)"/>

  <!-- Set the property 'robot_namespace' -->
  <xacro:make_namespace prop_id="robot_namespace" namespace="${namespace}" name="${robot_name}"/>

  <!-- Set the property 'robot_prefix' -->
  <xacro:make_prefix prop_id="robot_prefix" name="${robot_name}"/>

  <!--
  If use_sim_mode is False (working in a real deployment), do not load the simulation configuration for the robot from
  the simulation file.
  If use_sim_mode is True (working in simulation mode), and a configuration file is provided, load the simulation
  configuration from the file. If no configuration file is provided, use an empty configuration, so no gz plugins are
  loaded.
  -->
  <xacro:property name="core_sim_file" value="$(arg core_sim_file)"/>

  <xacro:if value="${use_sim_mode}">
    <xacro:if value="${core_sim_file != ''}">
      <xacro:property name="core_sim_cfg" value="${xacro.load_yaml(core_sim_file)}"/>
    </xacro:if>
    <xacro:if value="${core_sim_file == ''}">
      <xacro:property name="core_sim_cfg" value="${dict()}"/>
    </xacro:if>
  </xacro:if>
  <xacro:unless value="${use_sim_mode}">
    <xacro:property name="core_sim_cfg" value="${dict()}"/>
  </xacro:unless>

  <xacro:property name="body_use_visual"       value="$(arg body_use_visual)"/>
  <xacro:property name="body_use_v_mesh"       value="$(arg body_use_v_mesh)"/>
  <xacro:property name="body_use_collision"    value="$(arg body_use_collision)"/>
  <xacro:property name="body_use_c_mesh"       value="$(arg body_use_c_mesh)"/>
  <xacro:property name="body_use_inertial"     value="$(arg body_use_inertial)"/>

  <!--
  base = body + wheels.
  In this case, the base is rectangular with 3 wheels, one in the front and two in the back.
  Body is the hull/chassis of the robot.
  Ballast to adjust the center of mass of the group (body + ballast)
  The ballast is modeled as a box of the same size as the body in the X and Y directions, but with a height equal to
  'ballast_height_ratio * body_size_z'.
  'ballast_height_ratio', in the range [0, 1], represents the proportion of the body's height that the ballast occupies.
  It should be a small value, e.g., 0.1 (10% of the base height), so that the center of mass of the group (body+ballast)
  is lowered.
  The ballast mass is equal to 'ballast_mass_ratio * body_mass'.
  'ballast_mass_ratio', in the range [0, 1], represents the proportion of the body's mass that the ballast has.
  It should be a large value, e.g., 0.9 (90% of the total mass), so that the center of mass of the group (body+ballast)
  is lowered.
  The ballast is positioned at the bottom of the body.
  The ballas does not need visual or collision elements since it is inside the body.
   -->
  <xacro:property name="mass_body_ballast"     value="500"/>
  <xacro:property name="body_size_x"           value="1.531034"/>
  <xacro:property name="body_size_y"           value="0.774138"/>
  <xacro:property name="body_size_z"           value="1.64"/>
  <xacro:property name="body_size"             value="${body_size_x} ${body_size_y} ${body_size_z}"/>
  <xacro:property name="body_wheelbase"        value="0.92"/>
  <xacro:property name="body_half_wheelbase"   value="${0.5 * body_wheelbase}"/>
  <xacro:property name="body_track_width"      value="0.438"/>
  <xacro:property name="body_half_track_width" value="${0.5 * body_track_width}"/>
  <xacro:property name="body_ground_clearance" value="0.06"/>
  <xacro:property name="ballast_mass_ratio"    value="0.95"/>
  <xacro:property name="ballast_height_ratio"  value="0.1"/>
  <xacro:property name="ballast_size_z"        value="${ballast_height_ratio * body_size_z}"/>

  <!--
  The frame of the mesh is located at its geometric center (See MeshLab), so it coincides with the frame of a box
  shape.
  Therefore, just one origin is needed no matter if a mesh or a box shape is used for the visual element.
  The frame of the body, '${robot_prefix}${base_name}_link', is located at the center of the bottom face of the mesh or
  box shape.
  Scale is 1 1 1.
  The mesh has no color information.
  To access the mesh just use <package>/<path_to_mesh_within_package>.
  -->
  <xacro:property name="body_mesh"        value="robot_flart/meshes/mesh_low_res.stl"/>
  <xacro:property name="body_origin"      value="0 0 ${0.5 * body_size_z} 0 0 0"/>
  <xacro:property name="body_scale"       value="1.0 1.0 1.0"/>
  <xacro:property name="body_color"       value="0.0 0.0 1.0 1.0"/>

  <xacro:property name="st_wheel_use_visual"   value="$(arg st_wheel_use_visual)"/>
  <xacro:property name="st_wheel_use_v_mesh"   value="$(arg st_wheel_use_v_mesh)"/>
  <!--
  Wheel always use collision elements, which means 'st_wheel_use_collision' is always True.
  Wheel always use a basic geometry for collision, which means 'st_wheel_use_c_mesh' is always False.
  Read the steerable_wheel macro for more details.
  -->
  <xacro:property name="st_wheel_use_inertial" value="$(arg st_wheel_use_inertial)"/>

  <xacro:property name="st_wheel_mass"    value="10.0"/>
  <xacro:property name="st_wheel_radius"  value="0.127"/>
  <xacro:property name="st_wheel_length"  value="0.082"/>
  <!--
  eut_robotics_description/meshes/wheels/standard_wheels/wheel.dae is a cylinder with its axis aligned with the Z axis,
  centered at the origin, and with radius 0.15 (size_x = size_y = 2 * radius = 0.3) and length 0.1 (size_z = 0.1).
  Thefore:
  scale_x = desired_diameter / 0.3 = (2 * radius) / 0.3 = (2 * 0.127) / 0.3 = 0.846666667
  scale_y = desired_diameter / 0.3 = (2 * radius) / 0.3 = (2 * 0.127) / 0.3 = 0.846666667
  scale_z = desired_length / 0.1 = 0.082 / 0.1 = 0.82

  The mesh 'standard_wheels/wheel.dae' has the form of a cylinder with its axis aligned with the Z axis, i.e., a
  cylinder lied on the ground with one of its circular flat faces touching the ground.
  According to the steerable_wheel macro, the visual and collision elements of the wheel are cylinders with their axis
  aligned with the Y axis, i.e., a cylinder standing on the ground with its curved surface touching the ground.
  Therefore, to use the mesh 'standard_wheels/wheel.dae' for the visual and collision elements of the wheel, we need to
  rotate the mesh 90 degrees (0.5 * pi radians) around the X axis (roll).
  This is achieved by setting the mesh_origin = "0.0 0.0 0.0 (0.5 * pi) 0.0 0.0".
  -->
  <xacro:property name="st_wheel_mesh"
                  value="${'eut_robotics_description/meshes/wheels/standard_wheels/wheel.dae' if st_wheel_use_v_mesh else ''}"/>
  <xacro:property name="st_wheel_mesh_scale"  value="0.846666667 0.846666667 0.82"/>
  <xacro:property name="st_wheel_mesh_origin" value="0.0 0.0 0.0 ${0.5 * pi} 0.0 0.0"/>
  <!--
  The 'eut_robotics_description/meshes/wheels/standard_wheels/wheel.dae' mesh has color information, therefore
  no color is needed.
  If use_v_mesh is False (meaning that the basic geometry is used instead of the mesh), then a color must be provided
  for the basic geometry.
  -->
  <xacro:property name="st_wheel_color"                value="${'' if st_wheel_use_v_mesh else '0.1 0.1 0.1 1.0'}"/>
  <xacro:property name="st_wheel_steerable_joint_type" value="revolute"/>
  <!--
  With this limits the steerable joint can rotate from [-pi, pi] radians.
  -->
  <xacro:property name="st_wheel_steerable_joint_lower_limit"     value="${-pi}"/>
  <xacro:property name="st_wheel_steerable_joint_upper_limit"     value="${pi}"/>
  <!--
  Important:
  The motion of this robot is controlled in velocity mode by a plugin of type 'gz::sim::systems::VelocityControl'.
  We are not commanding each wheel using torque/force or velocity commands.
  Therefore, we do not need accurate values for the friction parameters of the wheel (mu, mu2, slip1, slip2), just
  values that provide low friction to minimize the interaction of the wheels with the ground and allow the robot to move
  smoothly
  Besides, the velocity limit and effort limit for the steerable and rotation joints are set to such a high values that
  they model ideal joints.
  This is useful when the robot is controlled in velocity mode, to avoid the joint limits from interfering
  with the control.
  Read the macro 'steerable_wheel_macro.xacro' for more details about these limit parameters.
  -->
  <xacro:property name="st_wheel_steerable_limits"                value="${-pi} ${pi} 100.0 100000.0"/>
  <xacro:property name="st_wheel_rotation_joint_type"             value="continuous"/>
  <xacro:property name="st_wheel_rotation_joint_limits"           value="100.0 100000.0"/>
  <xacro:property name="st_wheel_max_contacts"                    value="1"/>
  <xacro:property name="st_wheel_mu"                              value="0.05"/>
  <xacro:property name="st_wheel_mu2"                             value="0.5"/>
  <xacro:property name="st_wheel_slip1"                           value="0.005"/>
  <xacro:property name="st_wheel_slip2"                           value="0.0005"/>

  <xacro:property name="fork_use_visual"       value="$(arg fork_use_visual)"/>
  <xacro:property name="fork_use_v_mesh"       value="$(arg fork_use_v_mesh)"/>
  <xacro:property name="fork_use_collision"    value="$(arg fork_use_collision)"/>
  <xacro:property name="fork_use_c_mesh"       value="$(arg fork_use_c_mesh)"/>
  <xacro:property name="fork_use_inertial"     value="$(arg fork_use_inertial)"/>

  <xacro:property name="fork_tine_mass"   value="60"/>
  <xacro:property name="fork_tine_size_x" value="1.19"/>
  <xacro:property name="fork_tine_size_y" value="0.119669"/>
  <xacro:property name="fork_tine_size_z" value="0.06"/>
  <!--
  The frame of the mesh is located at its geometric center (See MeshLab), so it coincides with the frame of a box
  shape.
  According to the comments found in the macro 'fork_macro.xacro', the values for 'tine_v_mesh_origin' and
  'tine_c_mesh_origin' must be set so that the frame of each tine link is located at the center of the top face of each
  tine mesh in case a mesh is used for the visual or collision element.
  Since the frame of the tine's mesh is located at its geometric center, to place the tine's frame at the center of the
  top face of the tine mesh, the following origin must be used: '0.0 0.0 (-0.5 * tine_size_z) 0.0 0.0 0.0'
  Scale is 1 1 1.
  The mesh has no color information, so usage of a color is encouraged.
  To access the mesh just use <package>/<path_to_mesh_within_package>.
  -->
  <xacro:property name="fork_tine_mesh"
                  value="eut_robotics_description/meshes/extras/fork_tine/mesh_low_res.stl"/>
  <xacro:property name="fork_tine_mesh_scale"  value="1.0 1.0 1.0"/>
  <xacro:property name="fork_tine_mesh_origin" value="0 0 ${-0.5 * fork_tine_size_z} 0 0 0"/>
  <xacro:property name="fork_color"            value="0.1 0.1 0.1 1.0"/>
  <xacro:property name="fork_base_mass"        value="70.0"/>
  <xacro:property name="fork_base_size_x"      value="0.035"/>
  <xacro:property name="fork_base_size_y"      value="0.7"/>
  <xacro:property name="fork_base_size_z"      value="0.5"/>
  <xacro:property name="fork_tine_separation"  value="0.2523306"/>
  <!--
  For prismatic joints, if you set the rest position of the joint at the lower limit, there is a risk that the joint
  gets stuck due to simulation precision issues; i.e, the joint could be initialized slightly below the lower limit.
  For example if the lower limit is 0, and the rest position of the joint is set to the lower limit, the joint could be
  spawn at −1.9e−12. This small negative value, beyond the lower limit, will block movements.
  Effort controllers are unaffected.
  To prevent this situation when the rest position of the joint is at the lower limit, you should set 'lower_limit' a
  bit below the proper lower limit, so if the joint is initialized slightly below the proper limit, it will not get
  stuck.
  Take into account that the deviation when spawning the joint, if it happens, is very small, so the extra margin
  you give to the lower limit is not significant.
  Same applies if the rest position of the joint is at the upper limit.
  If the joint rest position is in the middle of the limits, there is no risk of getting stuck, so there is no need
  to add extra margin to the limits.
  -->

  <xacro:property name="fork_lower_limit"     value="-0.01"/>
  <xacro:property name="fork_upper_limit"     value="0.8"/>
  <xacro:property name="fork_brake_distance"  value="0.20"/>
  <!--
  The velocity limit of 0.5 m/s is based on typical lift speeds of industrial forklifts, which commonly operate in the
  range of 0.4 - 0.6 m/s under load.
  -->
  <xacro:property name="fork_velocity_limit"              value="0.5"/>
  <xacro:property name="fork_effort_limit"                value="20000.0"/> <!-- why 20000? its big, no other reason -->
  <!-- Distance from the ground to the bottom face of the tines. -->
  <xacro:property name="fork_tines_rest_clearance"        value="0.02"/>

  <xacro:property name="robot_size_x" value="2.733"/>
  <xacro:property name="robot_size_y" value="0.774"/>
  <xacro:property name="robot_size_z" value="1.7004688"/>

  <!-- Names for components -->
  <xacro:property name="base_name"                value="base"/>
  <xacro:property name="front_st_wheel_name"      value="front_steerable_wheel"/>      <!-- Alternative: fsw -->
  <xacro:property name="rear_left_st_wheel_name"  value="rear_left_steerable_wheel"/>  <!-- Alternative: rlsw -->
  <xacro:property name="rear_right_st_wheel_name" value="rear_right_steerable_wheel"/> <!-- Alternative: rrsw -->
  <xacro:property name="fork_name"                value="fork"/>

  <!-- ===================================================================== -->
  <!-- Definition of links and joints for the rectangular base -->
  <!-- ===================================================================== -->

  <!--
  The link '${base_name}footprint_link' is located on the ground, just below the link '${base_name}_link', at a distance
  of 'ground_clearance' meters.
  -->
  <link name="${robot_prefix}${base_name}_footprint_link"/>

  <link name="${robot_prefix}${base_name}_link">
    <!--
    Check if a visual element must be used for the body.
    Only the boby can be visualized; the ballast is inside the body and is not visualized.
     -->
    <xacro:if value="${body_use_visual}">
      <xacro:property name="body_v_mesh" value="${body_mesh if body_use_v_mesh else ''}"/>
      <!--
      The link is located at the center of the bottom face of the body, so the visual part is completely above the link.
      -->
      <xacro:visual_box mesh="${body_v_mesh}"
                        scale="${body_scale}"
                        mesh_origin="${body_origin}"
                        size="${body_size}"
                        shape_origin="${body_origin}"
                        color="${robot_prefix}${base_name}_color ${body_color}"/>
    </xacro:if>

    <xacro:if value="${body_use_collision}">
      <xacro:property name="body_c_mesh" value="${body_mesh if body_use_c_mesh else ''}"/>
      <!--
      The link is located at the center of the bottom face of the body, so the collision part is completely above the
      link.
      -->
      <xacro:collision_box mesh="${body_c_mesh}"
                           scale="${body_scale}"
                           mesh_origin="${body_origin}"
                           size="${body_size}"
                           shape_origin="${body_origin}"/>
    </xacro:if>

    <xacro:if value="${body_use_inertial}">
      <!-- Place the CoM half length up above the root link. -->
      <xacro:solid_box_inertia mass="${(1.0 - ballast_mass_ratio) * mass_body_ballast}"
                               size="${body_size}"
                               origin="${body_origin}"/>
    </xacro:if>

    <xacro:unless value="${body_use_inertial}">
        <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}${base_name}_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_footprint_link"/>
    <child link="${robot_prefix}${base_name}_link"/>
    <!--
    The link '${base_name}_link' is located at the center of the bottom face of the body, so it is at a height of
    'ground_clearance' meters above the link '${base_name}_footprint_link'.
    -->
    <origin rpy="0 0 0" xyz="0 0 ${body_ground_clearance}"/>
  </joint>

  <!--
  Conceptually, the ballast is a box with dimensions 'body_size_x' x 'body_size_y' x 'ballast_size_z', with the frame
  located at the center of its bottom face. Therefore, the frame of the ballast link coincides with the frame of the
  body link.
  The visual element is not shown since it is inside the body.
  The collision element is not defined since it is inside the body, so the collision element of the body takes care of
  collisions.
  The inertial element is defined only if the body has an inertial element, so both body and ballast have or not have
  inertial elements.
  -->
  <link name="${robot_prefix}${base_name}_ballast_link">
    <xacro:if value="${body_use_inertial}">
      <xacro:solid_box_inertia mass="${ballast_mass_ratio * mass_body_ballast}"
                               size="${body_size}"
                               origin="0.0 0.0 ${0.5 * ballast_size_z} 0.0 0.0 0.0"/>
    </xacro:if>

    <xacro:unless value="${body_use_inertial}">
        <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}${base_name}_ballast_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}${base_name}_ballast_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>

  <!--
  Definition of the steerable wheels.
  -->

  <!-- z-coordinate of each steerable wheel w.r.t it parent frame -->
  <xacro:property name="z_st_wheel" value="${-body_ground_clearance + st_wheel_radius}"/>

  <xacro:steerable_wheel name="${front_st_wheel_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="${st_wheel_use_visual}"
                         use_inertial="${st_wheel_use_inertial}"
                         v_mesh="${st_wheel_mesh}"
                         v_mesh_scale="${st_wheel_mesh_scale}"
                         v_mesh_origin="${st_wheel_mesh_origin}"
                         color="${st_wheel_color}"
                         radius="${st_wheel_radius}"
                         length="${st_wheel_length}"
                         mass="${st_wheel_mass}"
                         steerable_joint_type="${st_wheel_steerable_joint_type}"
                         steerable_joint_steerable_limits="${st_wheel_steerable_limits}"
                         rotation_joint_type="${st_wheel_rotation_joint_type}"
                         rotation_joint_limits="${st_wheel_rotation_joint_limits}"
                         max_contacts="${st_wheel_max_contacts}"
                         mu="${st_wheel_mu}"
                         mu2="${st_wheel_mu2}"
                         slip1="${st_wheel_slip1}"
                         slip2="${st_wheel_slip2}"
                         joint_parent_fr_wheel_fr="${body_half_wheelbase} 0.0 ${z_st_wheel} 0.0 0.0 0.0"/>

  <xacro:steerable_wheel name="${rear_left_st_wheel_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="${st_wheel_use_visual}"
                         use_inertial="${st_wheel_use_inertial}"
                         v_mesh="${st_wheel_mesh}"
                         v_mesh_scale="${st_wheel_mesh_scale}"
                         v_mesh_origin="${st_wheel_mesh_origin}"
                         color="${st_wheel_color}"
                         radius="${st_wheel_radius}"
                         length="${st_wheel_length}"
                         mass="${st_wheel_mass}"
                         steerable_joint_type="${st_wheel_steerable_joint_type}"
                         steerable_joint_steerable_limits="${st_wheel_steerable_limits}"
                         rotation_joint_type="${st_wheel_rotation_joint_type}"
                         rotation_joint_limits="${st_wheel_rotation_joint_limits}"
                         max_contacts="${st_wheel_max_contacts}"
                         mu="${st_wheel_mu}"
                         mu2="${st_wheel_mu2}"
                         slip1="${st_wheel_slip1}"
                         slip2="${st_wheel_slip2}"
                         joint_parent_fr_wheel_fr="${-body_half_wheelbase} ${body_half_track_width} ${z_st_wheel} 0.0 0.0 0.0"/>

  <xacro:steerable_wheel name="${rear_right_st_wheel_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="${st_wheel_use_visual}"
                         use_inertial="${st_wheel_use_inertial}"
                         v_mesh="${st_wheel_mesh}"
                         v_mesh_scale="${st_wheel_mesh_scale}"
                         v_mesh_origin="${st_wheel_mesh_origin}"
                         color="${st_wheel_color}"
                         radius="${st_wheel_radius}"
                         length="${st_wheel_length}"
                         mass="${st_wheel_mass}"
                         steerable_joint_type="${st_wheel_steerable_joint_type}"
                         steerable_joint_steerable_limits="${st_wheel_steerable_limits}"
                         rotation_joint_type="${st_wheel_rotation_joint_type}"
                         rotation_joint_limits="${st_wheel_rotation_joint_limits}"
                         max_contacts="${st_wheel_max_contacts}"
                         mu="${st_wheel_mu}"
                         mu2="${st_wheel_mu2}"
                         slip1="${st_wheel_slip1}"
                         slip2="${st_wheel_slip2}"
                         joint_parent_fr_wheel_fr="${-body_half_wheelbase} ${-body_half_track_width} ${z_st_wheel} 0.0 0.0 0.0"/>

  <!-- ===================================================================== -->
  <!-- FORK -->
  <!-- ===================================================================== -->

  <!--
  padding_x, is the empty space between the front face of the base and the back face of the fork base.
  (Note: the tines start at the back face of the fork base)
  robot_size_x = body_size_x + padding_x + tine_size_x.
  padding_x = robot_size_x - body_size_x - tine_size_x.
  -->

  <xacro:property name="padding_x" value="${robot_size_x - body_size_x - fork_tine_size_x}"/>
  <!--
  The term -fork_base_size_x is because the frame for the fork base is located on its front face.
  -->
  <xacro:property name="joint_base_fr_fork_fr_x" value="${(-body_size_x * 0.5) - padding_x - fork_base_size_x}"/>

  <xacro:property name="joint_base_fr_fork_fr_z"
                  value="${-body_ground_clearance + fork_tine_size_z + fork_tines_rest_clearance}"/>

  <!--
  The fork macro will create the following links and joints:
  - Links:
    * ${prefix}${name}_tine_left_link = ${robot_prefix}${fork_name}_left_tine_link
    * ${prefix}${name}_tine_right_link = ${robot_prefix}${fork_name}_right_tine_link
    * ${prefix}${name}_root_link = ${robot_prefix}${fork_name}_root_link
  - Joints:
    * ${prefix}${name}_left_tine_joint = ${robot_prefix}${fork_name}_left_tine_joint, joining the links
      ${robot_prefix}${fork_name}_root_link and ${robot_prefix}${fork_name}_left_tine_link.
    * ${prefix}${name}_right_tine_joint = ${robot_prefix}${fork_name}_right_tine_joint, joining the links
      ${robot_prefix}${fork_name}_root_link and ${robot_prefix}${fork_name}_right_tine_link.
    * ${prefix}${name}_root_joint = ${robot_prefix}${fork_name}_root_joint, joining the links
      ${robot_prefix}${base_name}_link and ${robot_prefix}${fork_name}_root_link.
      -->
  <xacro:fork name="${fork_name}"
              prefix="${robot_prefix}"
              parent_frame="${robot_prefix}${base_name}_link"
              use_visual="${fork_use_visual}"
              use_collision="${fork_use_collision}"
              use_inertial="${fork_use_inertial}"
              tine_v_mesh="${fork_tine_mesh if fork_use_v_mesh else ''}"
              tine_v_mesh_scale="${fork_tine_mesh_scale}"
              tine_v_mesh_origin="${fork_tine_mesh_origin}"
              color="${fork_color}"
              tine_c_mesh="${fork_tine_mesh if fork_use_c_mesh else ''}"
              tine_c_mesh_scale="${fork_tine_mesh_scale}"
              tine_c_mesh_origin="${fork_tine_mesh_origin}"
              tine_size="${fork_tine_size_x} ${fork_tine_size_y} ${fork_tine_size_z}"
              tine_mass="${fork_tine_mass}"
              base_size="${fork_base_size_x} ${fork_base_size_y} ${fork_base_size_z}"
              base_mass="${fork_base_mass}"
              tine_separation="${fork_tine_separation}"
              limits="${fork_lower_limit} ${fork_upper_limit} ${fork_effort_limit} ${fork_velocity_limit}"
              joint_parent_fr_root_fr="${joint_base_fr_fork_fr_x} 0 ${joint_base_fr_fork_fr_z} 0 0 ${pi}"/>

  <!-- ===================================================================== -->
  <!-- PLUGINS FOR THE PLATFORM -->
  <!-- ===================================================================== -->

  <!--
  GZ plugins to:
  - Send velocity commands to the base to move the robot around.
  - Send joint_commands to:
    + Control the fork_root_joint in position.
    + Control the steerable joints of the wheels in position.
    + Control the rotation joints of the wheels in velocity.
  - Receive joint states from the non-fixed joints.

  This plugins simulate the behaviour the application uses to communicate with the real robot.
  -->

  <xacro:if value="${use_sim_mode}">
    <xacro:property name="base_sim_cfg" value="${core_sim_cfg.get('base', dict())}"/>

    <xacro:property name="base_velocity_controller_sim_cfg"
                    value="${base_sim_cfg.get('velocity_controller', dict())}"/>

    <xacro:property name="base_pose_ground_truth_publisher_sim_cfg"
                    value="${base_sim_cfg.get('pose_ground_truth_publisher', dict())}"/>

    <xacro:property name="steerable_wheel_steerable_joint_controller_sim_cfg"
                    value="${base_sim_cfg.get('steerable_wheel_steerable_joint_controller', dict())}"/>

    <xacro:property name="steerable_wheel_rotation_joint_controller_sim_cfg"
                    value="${base_sim_cfg.get('steerable_wheel_rotation_joint_controller', dict())}"/>

    <xacro:property name="fork_sim_cfg" value="${core_sim_cfg.get('fork', dict())}"/>

    <xacro:property name="fork_position_controller_sim_cfg"
                    value="${fork_sim_cfg.get('position_controller', dict())}"/>

    <xacro:property name="joint_state_publisher_sim_cfg"
                    value="${core_sim_cfg.get('joint_state_publisher', dict())}"/>

    <gazebo>
      <!--
      Reference for system plugins:
      https://gazebosim.org/api/gazebo/6/namespaceignition_1_1gazebo_1_1systems.html
      -->

      <!--
      Plugin VelocityControl to control the robot's motion by publishing a twist message (command message) that
      is subscribed by the plugin.
      -->
      <xacro:if value="${base_velocity_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="initial_linear"
                        value="${base_velocity_controller_sim_cfg.get('initial_linear', dict(x=0, y=0, z=0))}"/>

        <xacro:property name="initial_angular"
                        value="${base_velocity_controller_sim_cfg.get('initial_angular', dict(x=0, y=0, z=0))}"/>

        <!--
        Reference: https://gazebosim.org/api/gazebo/6/classignition_1_1gazebo_1_1systems_1_1VelocityControl.html
        Linear and angular velocity controller which is directly set on a model.
        -->
        <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
          <topic>${robot_namespace}/cmd_vel</topic>
          <initial_linear>${initial_linear['x']} ${initial_linear['y']} ${initial_linear['z']}</initial_linear>
          <initial_angular>${initial_angular['x']} ${initial_angular['y']} ${initial_angular['z']}</initial_angular>
        </plugin>
      </xacro:if>

      <!--
      Plugin 'OdometryPublisher' to publish the robot's pose on the GZ's world frame.
      -->

      <xacro:if value="${base_pose_ground_truth_publisher_sim_cfg.get('enabled', False)}">
        <!--
        Reference: https://gazebosim.org/api/gazebo/6/classignition_1_1gazebo_1_1systems_1_1OdometryPublisher.html
        This plugin publishes the absolute pose (position and orientation) and velocities of the robot with respect to
        Gazebo's world frame. Strictly speaking, odometry is the pose (and some might consider velocities as well) of
        the robot with respect to its starting pose. Global localization, on the other hand, is the pose (again, some
        might consider velocities as well) of the robot with respect to a fixed global frame considered the root frame
        for the entire application.
        The root frame for the application is usually called 'map' or 'world', and the odometry frame is usually
        called 'odom'. Each robot has its own odometry frame in an application, while there is usually a single global
        frame for the entire application.

        The whole point of the explanation above is to let the reader now that although the plugin is called
        'OdometryPublisher', it is in fact a source of global localization for the robot, with respect to Gazebo's world
        frame.
        Therefore, the plugin 'OdometryPublisher' is providing the transformation 'T_world_fr_robot_root_fr', where
        the term 'robot_root_fr' is the generic expression to describe the frame that acts as the root frame for the
        robot, in this file, '${robot_prefix}${base_name}_footprint_link', but in other robots it could be
        '${robot_prefix}${base_name}_link' or any other name.

       It is a good idea to set the root_frame to 'map' or 'world', depending on the conventions used in the rest of the
       application.
       If you use the value 'map' for root_frame, it is a good idea to set the tf_topic to 'tf_map_fr_robot_root_fr'.
       In the message's header the robot's root frame will be used as the child_frame_id, so there is no need to specify
       it here.
       If you go for a topic name like /tf, be careful, since this topic is usually used to publish all the TFs in the
       system and it might interfere with some other node publishing this transformation.
       If you use the node fake_localization in simulation you have two options:
       1. Use map as the root_frame and the tf_topic to any custom name, for example tf_map_fr_robot_root_fr.
          In this scenario you need another node publisth the tf odom->robot_root_frame.
          The node 'fake_localization' will use the odometry message published by this plugin and the tf
          odom->robot_root_frame published by the other node mentioned to publish the tf map->robot_root_frame.
       2. If you don't want to publish the tf odom->robot_root_frame from another node, you can set the root_frame to
          odom and the tf_topic to /tf, which is the topic that transport all the TFs in the system.
          In this scenario, the node 'fake_localization' will use the odometry message published by this plugin and the
          tf odom->robot_root_frame published on /tf by this plugin to publish the tf map->robot_root_frame.
        -->
        <xacro:property name="publication_frequency"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('publication_frequency', 50)}"/>

        <xacro:property name="offset"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>

        <xacro:property name="gaussian_noise"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('gaussian_noise', 0)}"/>

        <!--
        If the root frame is not specified, we assume it is 'map'.
        -->
        <xacro:property name="pose_ground_truth_fixed_frame"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('fixed_frame', 'sim_world')}"/>

        <xacro:property name="pose_ground_truth_tf_topic"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('tf_topic', 'tf_sim_root_fr_robot_root_fr')}"/>

        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
          <odom_frame>${pose_ground_truth_fixed_frame}</odom_frame>
          <robot_base_frame>${robot_prefix}${base_name}_footprint_link</robot_base_frame>
          <odom_publish_frequency>${publication_frequency}</odom_publish_frequency>
          <!--
          Custom topic on which this system will publish odometry messages.
          The rosgz_bridge for this robot will not send this topic to ROS2, instead it will send the topic with
          covariance.
          -->
          <odom_topic>${robot_namespace}/base_pose_ground_truth_wo_cov</odom_topic>
          <!--
          Custom topic on which this system will publish odometry with covariance messages.
          The rosgz_bridge for this robot will send this topic to ROS2.
          - The covariance is set as a diagonal matrix with the variance values set to the value of
          <gaussian_noise> squared.
          0 means no noise, and therefore no covariance.
          0.1 means a standard deviation of 0.1, and therefore a variance of 0.01.
          1.0 means a standard deviation of 1.0, and therefore a variance of 1.0.
          10.0 means a standard deviation of 10.0, and therefore a variance of 100.0.
          -->
          <odom_covariance_topic>${robot_namespace}/base_pose_ground_truth</odom_covariance_topic>
          <!--
          Custom topic on which this system will publish the transform T:odometry_frame -> robot_base_frame.
          -->
          <tf_topic>${robot_namespace}/${pose_ground_truth_tf_topic}</tf_topic>
          <dimensions>2</dimensions> <!-- 2D (x, y, yaw) -->
          <!--
          Position offset relative to the body fixed frame, the default value is 0 0 0.
          This offset will be added to the odometry message.
          -->
          <xyz_offset>${offset['x']} ${offset['y']} ${offset['z']}</xyz_offset>
          <!--
          Rotation offset relative to the body fixed frame, the default value is 0 0 0.
          This offset will be added to the odometry message.
          -->
          <rpy_offset>${offset['R']} ${offset['P']} ${offset['Y']}</rpy_offset>
          <!--
          Standard deviation of the Gaussian noise to be added to pose and twist messages.
          This element is optional, and the default value is 0.
          -->
          <gaussian_noise>${gaussian_noise}</gaussian_noise>
        </plugin>
      </xacro:if>
      <xacro:if value="${steerable_wheel_steerable_joint_controller_sim_cfg.get('enabled', False)}">
        <!-- Plugins to control the steerable joint of the steerable wheels. -->
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>${robot_prefix}${front_st_wheel_name}_steerable_joint</joint_name>
          <use_actuator_msg>true</use_actuator_msg>
          <!--
          It is assumed that the ThreeSwerveKinematicsSolverRos is used to compute the wheel commands.
          Therefore, index 0 in the position array in the actuator message corresponds to the steerable wheel located
          on the x-axis of the robot frame, either with positive x-coordinate or negative x-coordinate.
          Therefore, position at index 0 controls the orientation of the front steerable wheel in this robot.
          -->
          <actuator_number>0</actuator_number>
          <!--
          use_velocity_commands: Bypasses the PID and creates a perfect position.
          -->
          <use_velocity_commands>true</use_velocity_commands>
          <!--
          By using this huge, 100.0, value we allow the joint to reach any desired orientation instantly.
          -->
          <cmd_max>${steerable_wheel_steerable_joint_controller_sim_cfg.get('velocity', 100.0)}</cmd_max>
          <topic>${robot_namespace}/joint_commands/base</topic>
          <initial_position>0</initial_position>
        </plugin>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>${robot_prefix}${rear_left_st_wheel_name}_steerable_joint</joint_name>
          <use_actuator_msg>true</use_actuator_msg>
          <!--
          It is assumed that the ThreeSwerveKinematicsSolverRos is used to compute the wheel commands.
          Therefore, index 1 in the position array in the actuator message corresponds to the steerable wheel located
          opposite to steerable wheel 0, w.r.t the robot frame; i.e, if steerable wheel 0 is at positive x-coordinate,
          then steerable wheel 1 is at negative x-coordinate, and vice versa, and with positive y-coordinate.
          Therefore, position at index 1 controls the orientation of the rear left steerable wheel in this robot.
          -->
          <actuator_number>1</actuator_number>
          <!--
          use_velocity_commands: Bypasses the PID and creates a perfect position.
          -->
          <use_velocity_commands>true</use_velocity_commands>
          <!--
          By using this huge, 100.0, value we allow the joint to reach any desired orientation instantly.
          -->
          <cmd_max>${steerable_wheel_steerable_joint_controller_sim_cfg.get('velocity', 100.0)}</cmd_max>
          <topic>${robot_namespace}/joint_commands/base</topic>
          <initial_position>0</initial_position>
        </plugin>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>${robot_prefix}${rear_right_st_wheel_name}_steerable_joint</joint_name>
          <use_actuator_msg>true</use_actuator_msg>
          <!--
          It is assumed that the ThreeSwerveKinematicsSolverRos is used to compute the wheel commands.
          Therefore, index 2 in the position array in the actuator message corresponds to the steerable wheel located
          opposite to steerable wheel 0, w.r.t the robot frame; i.e, if steerable wheel 0 is at positive x-coordinate,
          then steerable wheel 1 is at negative x-coordinate, and vice versa, and with negative y-coordinate.
          Therefore, position at index 1 controls the orientation of the rear right steerable wheel in this robot.
          -->
          <actuator_number>2</actuator_number>
          <!--
          use_velocity_commands: Bypasses the PID and creates a perfect position.
          -->
          <use_velocity_commands>true</use_velocity_commands>
          <!--
          By using this huge, 100.0, value we allow the joint to reach any desired orientation instantly.
          -->
          <cmd_max>${steerable_wheel_steerable_joint_controller_sim_cfg.get('velocity', 100.0)}</cmd_max>
          <topic>${robot_namespace}/joint_commands/base</topic>
          <initial_position>0</initial_position>
        </plugin>
      </xacro:if>
      <xacro:if value="${steerable_wheel_rotation_joint_controller_sim_cfg.get('enabled', False)}">
        <!-- Plugin to control the rotation joint of the steerable wheels. -->
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
          <joint_name>${robot_prefix}${front_st_wheel_name}_rotation_joint</joint_name>
          <!--
          use_force_commands: True to enable the controller implementation using force commands. If this parameter is
          not set or is false, the controller will use velocity commands internally.
          -->
          <use_force_commands>false</use_force_commands>
          <use_actuator_msg>true</use_actuator_msg>
          <!--
          It is assumed that the ThreeSwerveKinematicsSolverRos is used to compute the wheel commands.
          Therefore, index 0 in the velocity array in the actuator message corresponds to the steerable wheel located
          on the x-axis of the robot frame, either with positive x-coordinate or negative x-coordinate.
          Therefore, velocity at index 0 controls the velocity of the front steerable wheel in this robot.
          -->
          <actuator_number>0</actuator_number>
          <topic>${robot_namespace}/joint_commands/base</topic>
          <!--
          NOT USED:
          <sub_topic> Sub topic to receive commands in. Defaults to "/model/<model_name>/<sub_topic>".
          -->
          <initial_velocity>0.0</initial_velocity>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
          <joint_name>${robot_prefix}${rear_left_st_wheel_name}_rotation_joint</joint_name>
          <use_force_commands>false</use_force_commands>
          <use_actuator_msg>true</use_actuator_msg>
          <!--
          It is assumed that the ThreeSwerveKinematicsSolverRos is used to compute the wheel commands.
          Therefore, index 1 in the velocity array in the actuator message corresponds to the steerable wheel located
          opposite to steerable wheel 0, w.r.t the robot frame; i.e, if steerable wheel 0 is at positive x-coordinate,
          then steerable wheel 1 is at negative x-coordinate, and vice versa, and with positive y-coordinate.
          Therefore, velocity at index 1 controls the velocity of the rear left steerable wheel in this robot.
          -->
          <actuator_number>1</actuator_number>
          <topic>${robot_namespace}/joint_commands/base</topic>
          <initial_velocity>0.0</initial_velocity>
        </plugin>
        <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
          <joint_name>${robot_prefix}${rear_right_st_wheel_name}_rotation_joint</joint_name>
          <use_force_commands>false</use_force_commands>
          <use_actuator_msg>true</use_actuator_msg>
          <!--
          It is assumed that the ThreeSwerveKinematicsSolverRos is used to compute the wheel commands.
          Therefore, index 2 in the velocity array in the actuator message corresponds to the steerable wheel located
          opposite to steerable wheel 0, w.r.t the robot frame; i.e, if steerable wheel 0 is at positive x-coordinate,
          then steerable wheel 2 is at negative x-coordinate, and vice versa, and with negative y-coordinate.
          Therefore, velocity at index 2 controls the velocity of the rear right steerable wheel in this robot.
          -->
          <actuator_number>2</actuator_number>
          <topic>${robot_namespace}/joint_commands/base</topic>
          <initial_velocity>0.0</initial_velocity>
        </plugin>
      </xacro:if>
      <!-- Plugin to control the fork position by sending position commands to the fork_root_joint. -->
      <xacro:if value="${fork_position_controller_sim_cfg.get('enabled', False)}">
        <!-- Reference: https://gazebosim.org/api/sim/8/classgz_1_1sim_1_1systems_1_1JointPositionController.html -->
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>${robot_prefix}fork_root_joint</joint_name>
          <joint_index>0</joint_index>
          <!--
          The following tags are NOT USED HERE, but are left commented for reference.
          - <use_actuator_msg>: True to enable the use of actutor message for position command. Relies on
          <actuator_number> for the index of the position actuator and defaults to topic "/actuators".
          Used with <use_actuator_commands> to set the index of the position actuator.
          - <actuator_number>
          - <p_gain>: The proportional gain of the PID. Default value is 1.
          - <i_gain>: The integral gain of the PID. Default value is 0.1.
          - <d_gain>: The derivative gain of the PID. Default value is 0.001.
          - <i_max>: The integral upper limit of the PID. Default value is 1.
          - <i_min>: The integral lower limit of the PID. Default value is -1.
          - <cmd_min>: The command minimum value of the PID. Default value is -1000.
          - <cmd_offset>: Command offset (feed-forward) of the PID. Default value is 0.
          -->
          <!--
          Bypasses the PID and creates a perfect position.
          The maximum speed on the joint can be set using the <cmd_max> tag.
          -->
          <use_velocity_commands>true</use_velocity_commands>
          <cmd_max>${fork_position_controller_sim_cfg.get('velocity', 0.3)}</cmd_max>
          <topic>${robot_namespace}/joint_commands/fork</topic>
          <!-- Initial position of a joint. -->
          <initial_position>0</initial_position>
        </plugin>
      </xacro:if>
      <xacro:if value="${joint_state_publisher_sim_cfg.get('enabled', False)}">
        <!--
        Plugin 'JointStatePublisher' to publish the position of the fork joint.
        Reference: https://gazebosim.org/api/sim/7/classgz_1_1sim_1_1systems_1_1JointStatePublisher.html#details
        -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
          <topic>${robot_namespace}/joint_states</topic>
          <joint_name>${robot_prefix}${fork_name}_root_joint</joint_name>
          <joint_name>${robot_prefix}${front_st_wheel_name}_steerable_joint</joint_name>
          <joint_name>${robot_prefix}${front_st_wheel_name}_rotation_joint</joint_name>
          <joint_name>${robot_prefix}${rear_left_st_wheel_name}_steerable_joint</joint_name>
          <joint_name>${robot_prefix}${rear_left_st_wheel_name}_rotation_joint</joint_name>
          <joint_name>${robot_prefix}${rear_right_st_wheel_name}_steerable_joint</joint_name>
          <joint_name>${robot_prefix}${rear_right_st_wheel_name}_rotation_joint</joint_name>
        </plugin>
      </xacro:if>
    </gazebo>
  </xacro:if>
</robot>
