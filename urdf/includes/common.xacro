<?xml version="1.0"?>
<!--
Common xacro file for the forki3 robot family.
THIS FILE IS NOT A COMPLETE ROBOT MODEL. IT IS MEANT TO BE INCLUDED FROM
THE PUBLIC MODEL XACRO FILES, FOR EXAMPLE MODEL_BASE.XACRO AND
MODEL_SENSETUP1.XACRO.

The common robot contains:
- the rectangular forklift base
- the three steerable wheels
- the simple fork
- the Gazebo plugins that belong to that common mechanical structure
-->
<robot name="forki3_common" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="robot_forki3_pkg_dir"              value="$(find robot_forki3)"/>
  <xacro:property name="robotics_description_pkg_dir"      value="$(find robotics_description)"/>

  <!-- ===================================================================== -->
  <!-- INCLUDES -->
  <!-- ===================================================================== -->

  <xacro:include filename="${robotics_description_pkg_dir}/urdf/common/all_commons.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/wheels/all_wheels.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/wheels/generic_macros/all_wheels_plugins.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/extras/fork_simple/fork_simple_macro.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/extras/fork_simple/generic_macros/plugin_fork_joint_f64_pos_velcmd_macro.xacro"/>
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/gz_system_plugins/all_gz_system_plugins.xacro"/>

  <!-- ===================================================================== -->
  <!-- ARGS -->
  <!-- ===================================================================== -->
  <!--
  When the xacro file is used in a real deployment, use_sim_mode should be set to False, wich provokes that no
  simulation plugins are loaded.
  When the xacro file is used in simulation, use_sim_mode should be set to True, so the simulation plugins are loaded.
  -->
  <xacro:arg name="use_sim_mode" default="False"/>
  <xacro:arg name="namespace"    default=""/>
  <xacro:arg name="robot_name"   default="forki3"/>
  <!--
  File containing the simulation configuration for the selected robot model.
  -->
  <xacro:arg name="sim_file"     default=""/>

  <!--
  Args for body
  The default values for the body correspond to the default mesh (mass, size, and inertia are consistent with that
  mesh). If the user changes the body mesh, they should also update the corresponding body parameters to
  maintain a consistent model. However, we cannot enforce this consistency in the xargs, so we provide the parameters
  independently and document their relationship in the description. The user is responsible for ensuring that the
  parameters are consistent with the chosen mesh.
  If the user scales body_mesh through body_scale, body_size must represent the final scaled dimensions.
  -->
  <xacro:arg name="body_use_inertial"      default="True"/>
  <xacro:arg name="mass"                   default="500"/>
  <xacro:arg name="body_size"              default="1.531 0.774 1.64"/>
  <xacro:arg name="ballast_size_z"         default="0.1"/>
  <xacro:arg name="body_ground_clearance"  default="0.06"/>
  <xacro:arg name="dist_to_wheels"         default="0.50"/>
  <xacro:arg name="alpha_deg"              default="154"/>
  <xacro:arg name="body_mesh"              default="robot_forki3/meshes/forki3_base.stl"/>
  <xacro:arg name="body_scale"             default="1.0 1.0 1.0"/>
  <xacro:arg name="body_color"             default="0.0 0.0 1.0 1.0"/>

  <!-- Wheels always use collision elements. Read the steerable_wheel macro for more details. -->
  <xacro:arg name="s_wheel_use_inertial"  default="True"/>
  <xacro:arg name="s_wheel_mass"          default="10.0"/>
  <xacro:arg name="s_wheel_radius"        default="0.127"/>
  <xacro:arg name="s_wheel_thickness"     default="0.082"/>
  <xacro:arg name="s_wheel_color"         default="0.1 0.1 0.1 1.0"/>
  <!--
  Note: If you want the wheel to be able to reach +-pi rad angle (+-180 degress), set limits to +-3.1416.
  pi = 3.141592654.... < 3.1416
  -->
  <xacro:arg name="s_wheel_steering_joint_limits" default="-3.1416 3.1416 100.0 100000.0"/>
  <xacro:arg name="s_wheel_rotation_joint_limits" default="100.0 100000.0"/>
  <xacro:arg name="s_wheel_max_contacts"          default="1"/>
  <xacro:arg name="s_wheel_mu"                    default="0.05"/>
  <xacro:arg name="s_wheel_mu2"                   default="0.5"/>
  <xacro:arg name="s_wheel_slip1"                 default="0.005"/>
  <xacro:arg name="s_wheel_slip2"                 default="0.0005"/>

  <!-- Arguments for the fork -->
  <xacro:arg name="fork_use_visual"     default="True"/>
  <xacro:arg name="fork_use_collision"  default="True"/>
  <!--
  A fork can add a large mass far from the base center of mass.
  If that inertia is included in simulation, the robot can oscillate or even tip over.
  This robot is used mainly for kinematic simulation, not for accurate dynamic simulation.
  For that reason, the fork inertia is disabled by default, so the fork is visible and attached
  to the robot, but it does not change the simulated base dynamics.
  -->
  <xacro:arg name="fork_use_inertial"   default="False"/>
  <xacro:arg name="fork_use_v_mesh"     default="True"/>
  <xacro:arg name="fork_color"          default="0.1 0.1 0.1 1.0"/>
  <xacro:arg name="fork_use_c_mesh"     default="True"/>
  <xacro:arg name="fork_limits"         default="-0.01 0.8 0.5 20000.0"/>
  <xacro:arg name="fork_rest_clearance" default="0.03"/>

  <!-- ===================================================================== -->
  <!-- DEFINITION OF PROPERTIES -->
  <!-- ===================================================================== -->

  <!-- Create properties from args for easy manipulation. -->

  <xacro:property name="use_sim_mode" value="$(arg use_sim_mode)"/>
  <xacro:property name="namespace"    value="$(arg namespace)"/>
  <xacro:property name="robot_name"   value="$(arg robot_name)"/>

  <!-- Set the property 'robot_namespace' -->
  <xacro:make_namespace prop_id="robot_namespace" namespace="${namespace}" name="${robot_name}"/>

  <!-- Set the property 'robot_prefix' -->
  <xacro:make_prefix prop_id="robot_prefix" name="${robot_name}"/>

  <!--
  If use_sim_mode is False (working in a real deployment), do not load the simulation configuration from the
  simulation file.
  If use_sim_mode is True (working in simulation mode), and a configuration file is provided, load the simulation
  configuration from the file. If no configuration file is provided, use an empty configuration, so no gz-plugins are
  loaded.
  -->
  <xacro:property name="sim_file"    value="$(arg sim_file)"/>
  <xacro:property name="sim_cfg"
                  value="${xacro.load_yaml(sim_file) if use_sim_mode and sim_file != '' else dict()}"/>

  <!-- Names for components -->
  <xacro:property name="base_name"                value="base"/>
  <xacro:property name="steerable_wheel_0_name"   value="steerable_wheel_0"/>
  <xacro:property name="steerable_wheel_1_name"   value="steerable_wheel_1"/>
  <xacro:property name="steerable_wheel_2_name"   value="steerable_wheel_2"/>
  <xacro:property name="fork_name"                value="fork"/>

  <xacro:property name="robot_size_x" value="2.737"/> <!-- orig: 2.733, now 2731 + 3 + 3 = 2737 -->
  <xacro:property name="robot_size_y" value="0.774"/>
  <xacro:property name="robot_size_z" value="1.7004688"/>

  <xacro:property name="body_use_inertial"  value="$(arg body_use_inertial)"/>

  <!--
  Base model overview:
  - The base is composed of the chassis body and three steerable wheels (one longitudinal on the x-axis, plus left and right).
  - The chassis mesh is used for visual and collision representation.
  - Dynamics are intentionally simplified: the chassis link uses null inertia, and the effective base mass/inertia are
    concentrated in an internal ballast link.

  Ballast model:
  - The ballast is a simple box located at the bottom of the chassis to keep the center of mass low and improve
    numerical stability.
  - This ballast represents the bulk mass of the real platform (including internal components not modeled in detail).
  - The ballast has no visual or collision geometry because it is fully inside the chassis; only its inertial properties
    are used.
  - This is a deliberate reduced-order dynamic model aimed at stable and practical simulation, not a full
    mass-distribution reconstruction of the real vehicle.
  -->
  <xacro:property name="mass"             value="$(arg mass)"/>
  <xacro:property name="body_size"        value="$(arg body_size)"/>
  <xacro:property name="body_size_values" value="${body_size.split()}"/>

  <!--
  The property 'body_size_values' is a list of the three components of 'body_size', which are expected to be separated
  by spaces.
  -->
  <xacro:if value="${len(body_size_values) != 3}">
    ${xacro.fatal("xacro arg body_size must contain exactly 3 values: x y z")}
  </xacro:if>

  <xacro:property name="body_size_x"           value="${float(body_size_values[0])}"/>
  <xacro:property name="body_size_y"           value="${float(body_size_values[1])}"/>
  <xacro:property name="body_size_z"           value="${float(body_size_values[2])}"/>
  <xacro:property name="body_ground_clearance" value="$(arg body_ground_clearance)"/>
  <xacro:property name="ballast_size_z"        value="$(arg ballast_size_z)"/>
  <xacro:property name="dist_to_wheels"        value="$(arg dist_to_wheels)"/>
  <xacro:property name="alpha_deg"             value="$(arg alpha_deg)"/>

  <xacro:if value="${float(dist_to_wheels) &lt;= 0.0}">
    ${xacro.fatal("xacro arg dist_to_wheels must be > 0")}
  </xacro:if>

  <xacro:if value="${float(alpha_deg) &lt;= 0.0 or float(alpha_deg) >= 180.0}">
    ${xacro.fatal("xacro arg alpha_deg must be in range (0, 180) degrees")}
  </xacro:if>

  <!--
  The frame of the mesh is located at its geometric center (See MeshLab), so it coincides with the frame of a box
  shape.
  Therefore, just one origin is needed no matter if a mesh or a box shape is used for the visual element.
  The frame of the body, '${robot_prefix}${base_name}_link', is located at the center of the bottom face of the mesh or
  box shape.
  Scale is configured with `body_scale`.
  The mesh has no color information.
  To access the mesh just use <package>/<path_to_mesh_within_package>.
  -->
  <xacro:property name="body_mesh"  value="$(arg body_mesh)"/>
  <xacro:property name="body_scale" value="$(arg body_scale)"/>
  <xacro:property name="body_color" value="$(arg body_color)"/>

  <!-- ===================================================================== -->
  <!-- Definition of links and joints for the rectangular base -->
  <!-- ===================================================================== -->

  <!--
  The link '${base_name}footprint_link' is located on the ground, just below the link '${base_name}_link', at a distance
  of 'ground_clearance' meters.
  -->
  <link name="${robot_prefix}${base_name}_footprint_link"/>

  <link name="${robot_prefix}${base_name}_link">
    <!--
    Visual and collision are always enabled for the base body.
    The ballast is inside the body, so it has no visual or collision elements.
    -->
    <visual>
      <geometry>
        <mesh filename="package://${body_mesh}" scale="${body_scale}"/>
      </geometry>
      <!--
      The stl has its frame located at its geometric center.
      By using rpy="0 0 0" and xyz="0 0 0.5*body_size_z", the link `${robot_prefix}${base_name}_link` is located at the
      center of the bottom face of the mesh
       -->
      <origin rpy="0 0 0" xyz="0 0 ${0.5 * body_size_z}"/>
      <material name="${robot_prefix}${base_name}_color">
        <color rgba="${body_color}"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://${body_mesh}" scale="${body_scale}"/>
      </geometry>
      <!--
      The stl has its frame located at its geometric center.
      By using rpy="0 0 0" and xyz="0 0 0.5*body_size_z", the link `${robot_prefix}${base_name}_link` is located at the
      center of the bottom face of the mesh
       -->
      <origin rpy="0 0 0" xyz="0 0 ${0.5 * body_size_z}"/>
    </collision>

    <xacro:null_inertia/>
  </link>

  <joint name="${robot_prefix}${base_name}_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_footprint_link"/>
    <child link="${robot_prefix}${base_name}_link"/>
    <!--
    The link '${base_name}_link' is located at the center of the bottom face of the body, so it is at a height of
    'ground_clearance' meters above the link '${base_name}_footprint_link'.
    -->
    <origin rpy="0 0 0" xyz="0 0 ${body_ground_clearance}"/>
  </joint>

  <!--
  The ballast is modeled as a box of size `body_size_x x body_size_y x ballast_size_z`, with its frame at the center of
  the bottom face. This makes the ballast-link frame coincide with the body-link frame.
  No visual or collision geometry is defined for the ballast because it is fully contained inside the body.
  The ballast inertia is enabled only when `body_use_inertial` is enabled.
  -->
  <link name="${robot_prefix}${base_name}_ballast_link">
    <xacro:if value="${body_use_inertial}">
      <xacro:solid_box_inertia mass="${mass}"
                               size="${body_size_x} ${body_size_y} ${ballast_size_z}"
                               origin="0.0 0.0 ${0.5 * ballast_size_z} 0.0 0.0 0.0"/>
    </xacro:if>

    <xacro:unless value="${body_use_inertial}">
        <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}${base_name}_ballast_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}${base_name}_ballast_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>

  <!--
  Definition of the steerable wheels.

  Wheel numbering aligned with ground_vehicle_kinematics:
  steerable_wheel_0 -> wheel on the robot X axis (x > 0 or x < 0 depending on geometry)
  steerable_wheel_1 -> left wheel
  steerable_wheel_2 -> right wheel
  Reference: package://ground_vehicle_kinematics/doc/kinematics_en.pdf

  Wheel always use collision elements, which means 's_wheel_use_collision' is always True.
  Wheel always use a basic geometry for collision, which means 's_wheel_use_c_mesh' is always False.
  Read the steerable_wheel macro for more details.
  -->
  <xacro:property name="s_wheel_use_inertial" value="$(arg s_wheel_use_inertial)"/>

  <xacro:property name="s_wheel_mass"                 value="$(arg s_wheel_mass)"/>
  <xacro:property name="s_wheel_radius"               value="$(arg s_wheel_radius)"/>
  <xacro:property name="s_wheel_thickness"            value="$(arg s_wheel_thickness)"/>
  <xacro:property name="s_wheel_mesh"                 value=""/>
  <xacro:property name="s_wheel_mesh_scale"           value="1.0 1.0 1.0"/>
  <xacro:property name="s_wheel_color"                value="$(arg s_wheel_color)"/>
  <xacro:property name="s_wheel_steering_joint_type"  value="revolute"/>
  <!--
  With this limits the steering joint can rotate from [-pi, pi] radians.
  -->
  <xacro:property name="s_wheel_steering_joint_lower_limit" value="${-pi}"/>
  <xacro:property name="s_wheel_steering_joint_upper_limit" value="${pi}"/>
  <!--
  Important:
  The motion of this robot is controlled in velocity mode by a plugin of type 'gz::sim::systems::VelocityControl'.
  Each wheel is not commanded directly through torque/force or velocity commands.
  Therefore, accurate values for the friction parameters of the wheel are not required (mu, mu2, slip1, slip2), just
  values that provide low friction to minimize the interaction of the wheels with the ground and allow the robot to move
  smoothly
  Besides, the velocity limit and effort limit for the steering and rotation joints are set to such a high values that
  they model ideal joints.
  This is useful when the robot is controlled in velocity mode, to avoid the joint limits from interfering
  with the control.
  Read the macro 'steerable_wheel_macro.xacro' for more details about these limit parameters.
  -->
  <xacro:property name="s_wheel_steering_joint_limits" value="$(arg s_wheel_steering_joint_limits)"/>
  <xacro:property name="s_wheel_rotation_joint_type"   value="continuous"/>
  <xacro:property name="s_wheel_rotation_joint_limits" value="$(arg s_wheel_rotation_joint_limits)"/>
  <xacro:property name="s_wheel_max_contacts"          value="$(arg s_wheel_max_contacts)"/>
  <xacro:property name="s_wheel_mu"                    value="$(arg s_wheel_mu)"/>
  <xacro:property name="s_wheel_mu2"                   value="$(arg s_wheel_mu2)"/>
  <xacro:property name="s_wheel_slip1"                 value="$(arg s_wheel_slip1)"/>
  <xacro:property name="s_wheel_slip2"                 value="$(arg s_wheel_slip2)"/>

  <!-- z-coordinate of each steerable wheel w.r.t it parent frame -->
  <xacro:property name="z_s_wheel" value="${-body_ground_clearance + s_wheel_radius}"/>
  <xacro:property name="d"         value="${float(dist_to_wheels)}"/>
  <xacro:property name="alpha"     value="${radians(float(alpha_deg))}"/>
  <!--
  Wheel planar coordinates from polar form:
  - Left wheel uses angle +alpha:
      x_left = d*cos(+alpha)
      y_left = d*sin(+alpha)
  - Right wheel uses angle -alpha:
      x_right = d*cos(-alpha)
      y_right = d*sin(-alpha)
  Using trigonometric parity:
  - cos(-alpha) = cos(alpha) -> x_right = x_left
  - sin(-alpha) = -sin(alpha) -> y_right = -y_left
  -->
  <xacro:property name="x_s_wheel_left"  value="${d * cos(alpha)}"/>
  <xacro:property name="y_s_wheel_left"  value="${d * sin(alpha)}"/>
  <xacro:property name="x_s_wheel_right" value="${x_s_wheel_left}"/>
  <xacro:property name="y_s_wheel_right" value="${-y_s_wheel_left}"/>
  <!--
  The longitudinal wheel is located on the x-axis, so its y coordinate is 0.
  The x coordinate of the longitudinal wheel depends on the angle alpha:
- If alpha >= 90 degrees, the longitudinal wheel is located in front of the robot, so its x coordinate is positive and
  equal to d.
- If alpha < 90 degrees, the longitudinal wheel is located at the back of the robot, so its x coordinate is negative and
  equal to -d.
  -->
  <xacro:property name="x_s_wheel_longitudinal" value="${d if float(alpha_deg) >= 90.0 else -d}"/>

  <!--
  The steerable_wheel macro creates:
  - Links:
    * ${prefix}${name}_steerable_link
    * ${prefix}${name}_rotation_link
  - Joints:
    * ${prefix}${name}_steering_joint (revolute|fixed):
      parent=${parent_frame}, child=${prefix}${name}_steerable_link
    * ${prefix}${name}_rotation_joint (continuous|fixed):
      parent=${prefix}${name}_steerable_link, child=${prefix}${name}_rotation_link
  -->
  <xacro:steerable_wheel name="${steerable_wheel_0_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="True"
                         use_inertial="${s_wheel_use_inertial}"
                         v_mesh="${s_wheel_mesh}"
                         v_mesh_scale="${s_wheel_mesh_scale}"
                         color="${s_wheel_color}"
                         radius="${s_wheel_radius}"
                         length="${s_wheel_thickness}"
                         mass="${s_wheel_mass}"
                         steering_joint_type="${s_wheel_steering_joint_type}"
                         steering_joint_limits="${s_wheel_steering_joint_limits}"
                         rotation_joint_type="${s_wheel_rotation_joint_type}"
                         rotation_joint_limits="${s_wheel_rotation_joint_limits}"
                         max_contacts="${s_wheel_max_contacts}"
                         mu="${s_wheel_mu}"
                         mu2="${s_wheel_mu2}"
                         slip1="${s_wheel_slip1}"
                         slip2="${s_wheel_slip2}"
                         joint_parent_fr_wheel_fr="${x_s_wheel_longitudinal} 0.0 ${z_s_wheel} 0.0 0.0 0.0"/>

  <xacro:steerable_wheel name="${steerable_wheel_1_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="True"
                         use_inertial="${s_wheel_use_inertial}"
                         v_mesh="${s_wheel_mesh}"
                         v_mesh_scale="${s_wheel_mesh_scale}"
                         color="${s_wheel_color}"
                         radius="${s_wheel_radius}"
                         length="${s_wheel_thickness}"
                         mass="${s_wheel_mass}"
                         steering_joint_type="${s_wheel_steering_joint_type}"
                         steering_joint_limits="${s_wheel_steering_joint_limits}"
                         rotation_joint_type="${s_wheel_rotation_joint_type}"
                         rotation_joint_limits="${s_wheel_rotation_joint_limits}"
                         max_contacts="${s_wheel_max_contacts}"
                         mu="${s_wheel_mu}"
                         mu2="${s_wheel_mu2}"
                         slip1="${s_wheel_slip1}"
                         slip2="${s_wheel_slip2}"
                         joint_parent_fr_wheel_fr="${x_s_wheel_left} ${y_s_wheel_left} ${z_s_wheel} 0.0 0.0 0.0"/>

  <xacro:steerable_wheel name="${steerable_wheel_2_name}"
                         prefix="${robot_prefix}"
                         parent_frame="${robot_prefix}${base_name}_link"
                         use_visual="True"
                         use_inertial="${s_wheel_use_inertial}"
                         v_mesh="${s_wheel_mesh}"
                         v_mesh_scale="${s_wheel_mesh_scale}"
                         color="${s_wheel_color}"
                         radius="${s_wheel_radius}"
                         length="${s_wheel_thickness}"
                         mass="${s_wheel_mass}"
                         steering_joint_type="${s_wheel_steering_joint_type}"
                         steering_joint_limits="${s_wheel_steering_joint_limits}"
                         rotation_joint_type="${s_wheel_rotation_joint_type}"
                         rotation_joint_limits="${s_wheel_rotation_joint_limits}"
                         max_contacts="${s_wheel_max_contacts}"
                         mu="${s_wheel_mu}"
                         mu2="${s_wheel_mu2}"
                         slip1="${s_wheel_slip1}"
                         slip2="${s_wheel_slip2}"
                         joint_parent_fr_wheel_fr="${x_s_wheel_right} ${y_s_wheel_right} ${z_s_wheel} 0.0 0.0 0.0"/>

  <!-- ===================================================================== -->
  <!-- FORK -->
  <!-- ===================================================================== -->
  <xacro:property name="fork_use_visual"     value="$(arg fork_use_visual)"/>
  <xacro:property name="fork_use_collision"  value="$(arg fork_use_collision)"/>
  <xacro:property name="fork_use_inertial"   value="$(arg fork_use_inertial)"/>
  <xacro:property name="fork_use_v_mesh"     value="$(arg fork_use_v_mesh)"/>
  <xacro:property name="fork_color"          value="$(arg fork_color)"/>
  <xacro:property name="fork_use_c_mesh"     value="$(arg fork_use_c_mesh)"/>
  <xacro:property name="fork_limits"         value="$(arg fork_limits)"/>
  <xacro:property name="fork_rest_clearance" value="$(arg fork_rest_clearance)"/>

  <xacro:property name="fork_limits_seq"   value="${fork_limits.split()}"/>

  <xacro:if value="${len(fork_limits_seq) != 4}">
    ${xacro.fatal("xacro arg fork_limits must contain exactly 4 values: lower upper velocity effort")}
  </xacro:if>

  <xacro:property name="fork_lower_limit" value="${float(fork_limits_seq[0])}"/>
  <xacro:property name="fork_upper_limit" value="${float(fork_limits_seq[1])}"/>

  <!--
  Lower limit for the fork joint must be less than or equal to upper limit, and the limits must
  satisfy lower <= 0 <= upper so that the joint can be at its rest position (q=0) without violating
  the limits.
  -->
  <xacro:if value="${fork_lower_limit > fork_upper_limit}">
    ${xacro.fatal("xacro arg fork_limits must satisfy lower &lt;= upper")}
  </xacro:if>

  <xacro:if value="${fork_lower_limit > 0.0 or fork_upper_limit &lt; 0.0}">
    ${xacro.fatal("xacro arg fork_limits must satisfy lower &lt;= 0 &lt;= upper, so q=0 is valid")}
  </xacro:if>

  <xacro:if value="${fork_lower_limit &lt; -float(fork_rest_clearance)}">
    ${xacro.fatal("xacro args fork_limits and fork_rest_clearance are inconsistent: the allowed downward fork travel exceeds the rest clearance")}
  </xacro:if>

  <!--
  The mast is the vertical structure that supports the fork and guides its vertical motion.
  `mast_left_beam` and `mast_right_beam` are the two vertical bars fixed to the robot body.
  -->

  <!-- mast_left_beam -->
  <xacro:property name="mast_mass"     value="10.0"/>
  <xacro:property name="mast_len_x"    value="0.03"/>
  <xacro:property name="mast_len_y"    value="0.03"/>
  <xacro:property name="mast_len_z"    value="${fork_upper_limit - fork_lower_limit}"/>
  <xacro:property name="mast_origin_x" value="0"/>
  <xacro:property name="mast_origin_y" value="0"/>
  <xacro:property name="mast_origin_z" value="0"/>

  <link name="${robot_prefix}${base_name}_mast_left_beam_link">
    <xacro:if value="${fork_use_visual}">
      <visual>
        <geometry>
          <box size="${mast_len_x} ${mast_len_y} ${mast_len_z}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="${mast_origin_x} ${mast_origin_y} ${mast_origin_z}"/>
        <material name="${robot_prefix}${fork_name}_color">
          <color rgba="${fork_color}"/>
        </material>
      </visual>
    </xacro:if>

    <xacro:if value="${fork_use_collision}">
      <collision>
        <geometry>
          <box size="${mast_len_x} ${mast_len_y} ${mast_len_z}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="${mast_origin_x} ${mast_origin_y} ${mast_origin_z}"/>
      </collision>
    </xacro:if>

    <xacro:if value="${fork_use_inertial}">
      <xacro:solid_box_inertial mass="${mast_mass}"
                                size="${mast_len_x} ${mast_len_y} ${mast_len_z}"
                                origin="${mast_origin_x} ${mast_origin_y} ${mast_origin_z} 0 0 0"/>
    </xacro:if>

    <xacro:unless value="${fork_use_inertial}">
      <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <xacro:property name="mast_mount_x" value="${-0.5 * (body_size_x + mast_len_x)}"/>
  <xacro:property name="mast_mount_y" value="${0.5 * (body_size_y - mast_len_y)}"/>
  <!--
  mast goes from
  inferior = -body_ground_clearance + fork_rest_clearance + fork_lower_limit
  to
  superior = inf + mast_len_z

  The center is (sup + inf)/2 = (inf + mast_len_z + inf)/2 = inf + mast_len_z/2
  -->
  <xacro:property name="mast_mount_z" value="${-body_ground_clearance + fork_rest_clearance + fork_lower_limit + (0.5 * mast_len_z)}"/>

  <joint name="${robot_prefix}${base_name}_mast_left_beam_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}${base_name}_mast_left_beam_link"/>
    <origin rpy="0 0 0" xyz="${mast_mount_x} ${mast_mount_y} ${mast_mount_z}"/>
  </joint>

  <!-- mast_right_beam -->
  <link name="${robot_prefix}${base_name}_mast_right_beam_link">
    <xacro:if value="${fork_use_visual}">
      <visual>
        <geometry>
          <box size="${mast_len_x} ${mast_len_y} ${mast_len_z}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="${mast_origin_x} ${mast_origin_y} ${mast_origin_z}"/>
        <material name="${robot_prefix}${fork_name}_color">
          <color rgba="${fork_color}"/>
        </material>
      </visual>
    </xacro:if>

    <xacro:if value="${fork_use_collision}">
      <collision>
        <geometry>
          <box size="${mast_len_x} ${mast_len_y} ${mast_len_z}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="${mast_origin_x} ${mast_origin_y} ${mast_origin_z}"/>
      </collision>
    </xacro:if>

    <xacro:if value="${fork_use_inertial}">
      <xacro:solid_box_inertial mass="${mast_mass}"
                                size="${mast_len_x} ${mast_len_y} ${mast_len_z}"
                                origin="${mast_origin_x} ${mast_origin_y} ${mast_origin_z} 0 0 0"/>
    </xacro:if>

    <xacro:unless value="${fork_use_inertial}">
      <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <joint name="${robot_prefix}${base_name}_mast_right_beam_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}${base_name}_mast_right_beam_link"/>
    <origin rpy="0 0 0" xyz="${mast_mount_x} ${-mast_mount_y} ${mast_mount_z}"/>
  </joint>

  <xacro:property name="fork_carriage_len_x"   value="0.03"/>
  <xacro:property name="fork_carriage_mount_x" value="${mast_mount_x - (0.5*mast_len_x)}"/>
  <xacro:property name="fork_carriage_mount_y" value="0"/>
  <xacro:property name="fork_carriage_mount_z" value="${-body_ground_clearance + fork_rest_clearance}"/>
  <xacro:property name="tine_size_x"           value="1.20"/>
  <xacro:property name="tine_size_y"           value="0.12"/>
  <xacro:property name="tine_size_z"           value="0.06"/>
  <xacro:property name="tine_separation"       value="0.25"/>

  <xacro:fork_simple name="${fork_name}"
                     prefix="${robot_prefix}"
                     parent_frame="${robot_prefix}${base_name}_link"
                     use_visual="${fork_use_visual}"
                     use_collision="${fork_use_collision}"
                     use_inertial="${fork_use_inertial}"
                     use_v_mesh="${fork_use_v_mesh}"
                     color="${fork_color}"
                     use_c_mesh="${fork_use_c_mesh}"
                     carriage_len_x="${fork_carriage_len_x}"
                     carriage_len_y="${body_size_y}"
                     limits="${fork_limits}"
                     joint_parent_fr_root_fr="${fork_carriage_mount_x} ${fork_carriage_mount_y} ${fork_carriage_mount_z} 0 0 ${pi}"/>

  <!-- ===================================================================== -->
  <!-- PLUGINS FOR THE BASE -->
  <!-- ===================================================================== -->

  <xacro:if value="${use_sim_mode}">
    <gazebo>
      <!--
      To find the reference for the system Gazebo plugins:
      1. Go to: https://gazebosim.org/libs/
      2. Click in the link 'API & Tutorials' for the 'Sim' section.
      3. Click in the link 'gz::sim::systems'

      At the time of writing this text (March 2026), the link 'gz::sim::systems' points to the
      URL 'https://gazebosim.org/api/sim/10/namespacegz_1_1sim_1_1systems.html', for API reference
      10.1.1
      -->

      <!--
      Insert a the `VelocityControl` Gazebo plugin to control the robot's motion by applying the twist received on a
      message in a subscribed topic.
      The twist is applied directly to the robot's model in Gazebo, without simulating the effect of forces on the
      wheels or the ground.
      This allows for a simple and stable way to control the robot's motion in velocity mode, without the need to tune
      friction parameters or worry about wheel slip.
      -->
      <xacro:property name="base_velocity_controller_sim_cfg"
                      value="${sim_cfg.get('base_velocity_controller', dict())}"/>

      <xacro:if value="${base_velocity_controller_sim_cfg.get('enabled', False)}">
        <!--
        Preppend the prefix `bvc_` to all the properties related to the (b)ase (v)elocity
        (c)ontroller Gazebo plugin, to avoid name conflicts with other Gazebo plugins.
        -->
        <xacro:property name="bvc_topic" value="${base_velocity_controller_sim_cfg.get('topic', '')}"/>

        <!-- If the topic is empty, then the plugin is not loaded. -->
        <xacro:if value="${bvc_topic != ''}">
          <xacro:resolve_topic prop_id="bvc_resolved_topic"
                               topic="${bvc_topic}"
                               namespace="${robot_namespace}"/>

          <xacro:property name="bvc_initial_linear_vel"
                          value="${base_velocity_controller_sim_cfg.get('initial_linear_vel', dict(x=0, y=0, z=0))}"/>

          <xacro:property name="bvc_initial_angular_vel"
                          value="${base_velocity_controller_sim_cfg.get('initial_angular_vel', dict(x=0, y=0, z=0))}"/>

          <xacro:plugin_velocity_control
            topic="${bvc_resolved_topic}"
            initial_linear="${bvc_initial_linear_vel['x']} ${bvc_initial_linear_vel['y']} ${bvc_initial_linear_vel['z']}"
            initial_angular="${bvc_initial_angular_vel['x']} ${bvc_initial_angular_vel['y']} ${bvc_initial_angular_vel['z']}"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert the `OdometryPublisher` Gazebo plugin to publish true pose of the robot's w.r.t a selected fixed frame in
      Gazebo.
      IMPORTANT: The fixed frame does not need to be the world frame of Gazebo, it can be any pose (position +
      orientation) in Gazebo. For this goal you use the fields ....
      More details about this plugin in package://robotics_description/urdf/gz_system_plugins/plugin_odometry_publisher_macro.xacro
      -->
      <xacro:property name="base_pose_ground_truth_publisher_sim_cfg"
                      value="${sim_cfg.get('base_pose_ground_truth_publisher', dict())}"/>

      <xacro:if value="${base_pose_ground_truth_publisher_sim_cfg.get('enabled', False)}">
        <!--
        Preppend the prefix `bpgtp_` to all the properties related to the (b)ase (p)ose (g)round
        (t)ruth (p)ublisher Gazebo plugin, to avoid name conflicts with other Gazebo plugins.
        -->
        <xacro:property name="bpgtp_nav_topic_no_cov"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('nav_topic_no_cov', '')}"/>

        <xacro:property name="bpgtp_nav_topic_cov"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('nav_topic_cov', '')}"/>

        <xacro:property name="bpgtp_tf_topic"
                        value="${base_pose_ground_truth_publisher_sim_cfg.get('tf_topic', '')}"/>

        <!-- If one of the topics is empty, then the plugin is not loaded. -->
        <xacro:if value="${bpgtp_nav_topic_cov != '' and bpgtp_nav_topic_no_cov != '' and bpgtp_tf_topic != ''}">
          <xacro:resolve_topic prop_id="bpgtp_resolved_nav_topic_cov"
                               topic="${bpgtp_nav_topic_cov}"
                               namespace="${robot_namespace}"/>

          <xacro:resolve_topic prop_id="bpgtp_resolved_nav_topic_no_cov"
                               topic="${bpgtp_nav_topic_no_cov}"
                               namespace="${robot_namespace}"/>

          <xacro:resolve_topic prop_id="bpgtp_resolved_tf_topic"
                               topic="${bpgtp_tf_topic}"
                               namespace="${robot_namespace}"/>

          <xacro:property name="bpgtp_fixed_frame"
                          value="${base_pose_ground_truth_publisher_sim_cfg.get('fixed_frame', 'sim_world')}"/>

          <xacro:property name="bpgtp_offset"
                          value="${base_pose_ground_truth_publisher_sim_cfg.get('offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>

          <xacro:property name="bpgtp_global_offset"
                          value="${base_pose_ground_truth_publisher_sim_cfg.get('global_offset', dict(x=0, y=0, z=0, R=0, P=0, Y=0))}"/>

          <xacro:property name="bpgtp_gaussian_noise"
                          value="${base_pose_ground_truth_publisher_sim_cfg.get('gaussian_noise', 0)}"/>

          <xacro:property name="bpgtp_publication_frequency"
                          value="${base_pose_ground_truth_publisher_sim_cfg.get('publication_frequency', 50)}"/>

          <xacro:plugin_odometry_publisher
            odom_frame="${bpgtp_fixed_frame}"
            robot_base_frame="${robot_prefix}${base_name}_footprint_link"
            odom_publish_frequency="${bpgtp_publication_frequency}"
            odom_topic="${bpgtp_resolved_nav_topic_no_cov}"
            odom_covariance_topic="${bpgtp_resolved_nav_topic_cov}"
            tf_topic="${bpgtp_resolved_tf_topic}"
            dimensions="2"
            xyz_offset="${bpgtp_offset['x']} ${bpgtp_offset['y']} ${bpgtp_offset['z']}"
            rpy_offset="${bpgtp_offset['R']} ${bpgtp_offset['P']} ${bpgtp_offset['Y']}"
            xyz_global_offset="${bpgtp_global_offset['x']} ${bpgtp_global_offset['y']} ${bpgtp_global_offset['z']}"
            rpy_global_offset="${bpgtp_global_offset['R']} ${bpgtp_global_offset['P']} ${bpgtp_global_offset['Y']}"
            gaussian_noise="${bpgtp_gaussian_noise}"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert 3 'JointPositionController' Gazebo plugins, each one to control the steering joint of
      each steerable wheel.
      In this case, actuator messages (actuator_msgs/msg/Actuators) are used to transport the
      position of the steering joints.
      Velocity commands, derived from the positions, are used to control the steering joints,
      instead of using PIDs.
      By using velocity commands, bypassing the PIDs, we can achieve a perfect position for the
      steering joints.

      'sj' -> steering joint.
      -->

      <!--
      `JointPositionController` Gazebo plugin for the steering joint of the steerable wheel 0.
       -->

      <xacro:property name="sw0_sj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_0_steering_joint_controller', dict())}"/>

      <xacro:if value="${sw0_sj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw0_sj_topic"
                        value="${sw0_sj_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${sw0_sj_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${steerable_wheel_0_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${sw0_sj_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${sw0_sj_topic}"
            actuator_number="0"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the steering joint of the steerable wheel 1.
       -->

      <xacro:property name="sw1_sj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_1_steering_joint_controller', dict())}"/>

      <xacro:if value="${sw1_sj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw1_sj_topic"
                        value="${sw1_sj_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${sw1_sj_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${steerable_wheel_1_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${sw1_sj_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${sw1_sj_topic}"
            actuator_number="1"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointPositionController` Gazebo plugin for the steering joint of the steerable wheel 2.
       -->

      <xacro:property name="sw2_sj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_2_steering_joint_controller', dict())}"/>

      <xacro:if value="${sw2_sj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw2_sj_topic"
                        value="${sw2_sj_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${sw2_sj_topic != ''}">
          <xacro:plugin_swheel_steering_joint_am_pos_velcmd
            joint_name="${robot_prefix}${steerable_wheel_2_name}_steering_joint"
            joint_limits="${s_wheel_steering_joint_limits}"
            initial_position="${sw2_sj_controller_sim_cfg.get('initial_angle', '')}"
            namespace="${robot_namespace}"
            topic="${sw2_sj_topic}"
            actuator_number="2"/>
        </xacro:if>
      </xacro:if>

      <!--
      Insert 3 'JointController' Gazebo plugins, each one to control the rotation joint of each
      steerable wheel.
      In this case, actuator messages (actuator_msgs/msg/Actuators) are used to transport the
      velocity of the rotation joints.
      Pure velocity commands (no force derived from velocity) are used to control the steering joints,
      instead of using PIDs.

      'rj' -> rotation joint.
      -->

      <!--
      `JointController` Gazebo plugin for the rotation joint of the steerable wheel 0.
       -->
      <xacro:property name="sw0_rj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_0_rotation_joint_controller', dict())}"/>

      <xacro:if value="${sw0_rj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw0_rj_topic"
                        value="${sw0_rj_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${sw0_rj_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${steerable_wheel_0_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${sw0_rj_topic}"
            actuator_number="0"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the rotation joint of the steerable wheel 1.
       -->
      <xacro:property name="sw1_rj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_1_rotation_joint_controller', dict())}"/>

      <xacro:if value="${sw1_rj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw1_rj_topic"
                        value="${sw1_rj_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${sw1_rj_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${steerable_wheel_1_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${sw1_rj_topic}"
            actuator_number="1"/>
        </xacro:if>
      </xacro:if>

      <!--
      `JointController` Gazebo plugin for the rotation joint of the steerable wheel 2.
       -->
      <xacro:property name="sw2_rj_controller_sim_cfg"
                      value="${sim_cfg.get('base_steerable_wheel_2_rotation_joint_controller', dict())}"/>

      <xacro:if value="${sw2_rj_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="sw2_rj_topic"
                        value="${sw2_rj_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${sw2_rj_topic != ''}">
          <xacro:plugin_wheel_rotation_joint_am_vel
            joint_name="${robot_prefix}${steerable_wheel_2_name}_rotation_joint"
            joint_limits="${s_wheel_rotation_joint_limits}"
            initial_velocity="0.0"
            namespace="${robot_namespace}"
            topic="${sw2_rj_topic}"
            actuator_number="2"/>
        </xacro:if>
      </xacro:if>

      <!--
      Define a 'JointPositionController' Gazebo plugin to control the
      `${robot_prefix}${fork_name}_carriage_joint` in position.
      In this case, we use a float64 messages (std_msgs/msg/Float64) to transport the position
      for the `${robot_prefix}${fork_name}_carriage_joint`, instead of using actuator messages
      (actuator_msgs/msg/Actutors).
      A velocity command, derived from the position, is used to control the position of the
      `${robot_prefix}${fork_name}_carriage_joint`, instead of using PIDs.
      By using velocity commands, bypassing the PIDs, we can achieve a perfect position for the
      joint.
      -->
      <xacro:property name="fork_controller_sim_cfg" value="${sim_cfg.get('fork_controller', dict())}"/>

      <xacro:if value="${fork_controller_sim_cfg.get('enabled', False)}">
        <xacro:property name="fork_topic" value="${fork_controller_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${fork_topic != ''}">
          <xacro:plugin_fork_joint_f64_pos_velcmd
            joint_name="${robot_prefix}${fork_name}_carriage_joint"
            joint_limits="${fork_limits}"
            initial_position="${fork_controller_sim_cfg.get('initial_position', '')}"
            namespace="${robot_namespace}"
            topic="${fork_topic}"/>
        </xacro:if>
      </xacro:if>

    </gazebo>
  </xacro:if>
</robot>
