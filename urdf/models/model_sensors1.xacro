<?xml version="1.0"?>
<!--
The model `sensors1` is the forki3 robot with the sensor set that is added on top of
the common forklift model:
  - A top 3D LiDAR with integrated IMU (RoboSense Airy)
  - A rear RGBD camera (Intel RealSense D435)
  - A left tine RGBD camera (Intel RealSense D435)
  - A right tine RGBD camera (Intel RealSense D435)
-->
<robot name="forki3_sensors1" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- ===================================================================== -->
  <!-- INCLUDES -->
  <!-- ===================================================================== -->

  <xacro:include filename="$(find robot_forki3)/urdf/includes/common.xacro"/>

  <!--
  Be aware that if a property is not defined in this it is defined in the included model above.
  -->
  <xacro:include filename="${robotics_description_pkg_dir}/urdf/sensors/all_sensors_macro.xacro"/>

  <!-- ===================================================================== -->
  <!-- ARGS -->
  <!-- ===================================================================== -->
  <xacro:arg name="top_platform_use_visual"        default="True"/>
  <xacro:arg name="top_platform_use_collision"     default="True"/>
  <xacro:arg name="top_platform_use_inertial"      default="True"/>
  <xacro:arg name="top_platform_color"             default="0.0 0.0 1.0 1.0"/> <!-- By default same color as base -->

  <xacro:arg name="top_lidar_use_visual"         default="True"/>
  <xacro:arg name="top_lidar_use_collision"      default="True"/>
  <xacro:arg name="top_lidar_use_inertial"       default="True"/>
  <xacro:arg name="top_lidar_use_v_mesh"         default="False"/>
  <!--
  The low resolution mesh has its own color. Since the low resolution mesh is used by default, the default value for
  color is empty.
  -->
  <xacro:arg name="top_lidar_v_mesh_use_low_res" default="True"/>
  <xacro:arg name="top_lidar_color"              default=""/>
  <!-- Use shape instead of mesh for collision by default. -->
  <xacro:arg name="top_lidar_use_c_mesh"         default="False"/>
  <xacro:arg name="top_lidar_c_mesh_use_low_res" default="False"/>

  <xacro:arg name="fork_rgbd_use_visual"       default="True"/>
  <xacro:arg name="fork_rgbd_use_collision"    default="True"/>
  <xacro:arg name="fork_rgbd_use_inertial"     default="True"/>
  <xacro:arg name="fork_rgbd_use_v_mesh"       default="True"/>
  <xacro:arg name="fork_rgbd_color"            default="0.5 0.5 0.5 1.0"/>
  <!-- Use shape instead of mesh for collision by default. -->
  <xacro:arg name="fork_rgbd_use_c_mesh"       default="False"/>

  <xacro:arg name="left_tine_rgbd_use_visual"    default="True"/>
  <xacro:arg name="left_tine_rgbd_use_collision" default="True"/>
  <xacro:arg name="left_tine_rgbd_use_inertial"  default="True"/>
  <xacro:arg name="left_tine_rgbd_use_v_mesh"    default="True"/>
  <xacro:arg name="left_tine_rgbd_color"         default="0.5 0.5 0.5 1.0"/>
  <!-- Use shape instead of mesh for collision by default. -->
  <xacro:arg name="left_tine_rgbd_use_c_mesh"    default="False"/>

  <xacro:arg name="right_tine_rgbd_use_visual"    default="True"/>
  <xacro:arg name="right_tine_rgbd_use_collision" default="True"/>
  <xacro:arg name="right_tine_rgbd_use_inertial"  default="True"/>
  <xacro:arg name="right_tine_rgbd_use_v_mesh"    default="True"/>
  <xacro:arg name="right_tine_rgbd_color"         default="0.5 0.5 0.5 1.0"/>
  <!-- Use shape instead of mesh for collision by default. -->
  <xacro:arg name="right_tine_rgbd_use_c_mesh"    default="False"/>

  <!-- ===================================================================== -->
  <!-- DEFINITION OF PROPERTIES -->
  <!-- ===================================================================== -->

  <!-- Create properties from args for easy manipulation. -->

  <!-- Top platform -->
  <xacro:property name="top_platform_use_visual"        value="$(arg top_platform_use_visual)"/>
  <xacro:property name="top_platform_use_collision"     value="$(arg top_platform_use_collision)"/>
  <xacro:property name="top_platform_use_inertial"      value="$(arg top_platform_use_inertial)"/>
  <xacro:property name="top_platform_color"             value="$(arg top_platform_color)"/>

  <xacro:property name="top_platform_mass"              value="1"/>
  <xacro:property name="top_platform_size_x"            value="0.08"/>
  <xacro:property name="top_platform_size_y"            value="0.08"/>
  <xacro:property name="top_platform_size_z"            value="0.146"/>

  <!-- Top LiDAR: Robosense Airy -->
  <xacro:property name="top_lidar_use_visual"         value="$(arg top_lidar_use_visual)"/>
  <xacro:property name="top_lidar_use_collision"      value="$(arg top_lidar_use_collision)"/>
  <xacro:property name="top_lidar_use_inertial"       value="$(arg top_lidar_use_inertial)"/>
  <xacro:property name="top_lidar_use_v_mesh"         value="$(arg top_lidar_use_v_mesh)"/>
  <xacro:property name="top_lidar_v_mesh_use_low_res" value="$(arg top_lidar_v_mesh_use_low_res)"/>
  <xacro:property name="top_lidar_color"              value="$(arg top_lidar_color)"/>
  <xacro:property name="top_lidar_use_c_mesh"         value="$(arg top_lidar_use_c_mesh)"/>
  <xacro:property name="top_lidar_c_mesh_use_low_res" value="$(arg top_lidar_c_mesh_use_low_res)"/>

  <!-- Rear RGBD: RealSense D435 -->
  <xacro:property name="fork_rgbd_use_visual"         value="$(arg fork_rgbd_use_visual)"/>
  <xacro:property name="fork_rgbd_use_collision"      value="$(arg fork_rgbd_use_collision)"/>
  <xacro:property name="fork_rgbd_use_inertial"       value="$(arg fork_rgbd_use_inertial)"/>
  <xacro:property name="fork_rgbd_use_v_mesh"         value="$(arg fork_rgbd_use_v_mesh)"/>
  <xacro:property name="fork_rgbd_color"              value="$(arg fork_rgbd_color)"/>
  <!-- Use shape instead of mesh for collision by default. -->
  <xacro:property name="fork_rgbd_use_c_mesh"         value="$(arg fork_rgbd_use_c_mesh)"/>

  <!-- See macro realsense_d435_rgbd_macro.xacro to check properties. -->
  <xacro:property name="fork_rgbd_size_y"             value="0.090"/>

  <!-- ===================================================================== -->
  <!-- TOP PLATFORM -->
  <!-- ===================================================================== -->

  <!-- The frame of the top platform is located at the center of its bottom face. -->
  <xacro:property name="top_plaftorm_origin" value="0.0 0.0 ${0.5 * top_platform_size_z} 0.0 0.0 0.0"/>
  <xacro:property name="top_platform_size"
                  value="${top_platform_size_x} ${top_platform_size_y} ${top_platform_size_z}"/>

  <link name="${robot_prefix}top_platform_link">
    <xacro:if value="${top_platform_use_visual}">
      <xacro:visual_box size="${top_platform_size}"
                        shape_origin="${top_plaftorm_origin}"
                        color="${robot_prefix}top_platform_color ${top_platform_color}"/>

    </xacro:if>

    <xacro:if value="${top_platform_use_collision}">
      <xacro:collision_box size="${top_platform_size}" shape_origin="${top_plaftorm_origin}"/>
    </xacro:if>

    <xacro:if value="${top_platform_use_inertial}">
      <xacro:solid_box_inertia mass="${top_platform_mass}" size="${top_platform_size}" origin="${top_plaftorm_origin}"/>
    </xacro:if>

    <xacro:unless value="${top_platform_use_inertial}">
      <xacro:null_inertia/>
    </xacro:unless>
  </link>

  <!-- Top platform (tp), located at robot's ceiling, where the LiDAR is placed -->
  <joint name="${robot_prefix}top_platform_joint" type="fixed">
    <parent link="${robot_prefix}${base_name}_link"/>
    <child link="${robot_prefix}top_platform_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.08629 0.0 ${body_size_z}"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- TOP LIDAR: ROBOSENSE AIRY -->
  <!-- ===================================================================== -->

  <xacro:property name="top_lidar_sim_cfg" value="${sim_cfg.get('top_lidar', dict())}"/>

  <!--
  top_lidar_sim_cfg contains the simulation configuration for the Airy lidar plugin.
  top_lidar_imu_sim_cfg contains the simulation configuration for the integrated IMU plugin.
  -->
  <xacro:property name="top_lidar_imu_sim_cfg" value="${sim_cfg.get('top_lidar_imu', dict())}"/>

  <xacro:set_props_plugin_lidar_3d_ring prop_prefix="top_lidar_sim"
                                        sim_cfg="${top_lidar_sim_cfg}"/>

  <xacro:set_props_plugin_imu prop_prefix="top_lidar_imu_sim"
                              imu_sim_cfg="${top_lidar_imu_sim_cfg}"/>

  <xacro:robosense_airy
      name="top_lidar"
      prefix="${robot_prefix}"
      parent_frame="${robot_prefix}top_platform_link"
      use_visual="${top_lidar_use_visual}"
      use_collision="${top_lidar_use_collision}"
      use_inertial="${top_lidar_use_inertial}"
      use_v_mesh="${top_lidar_use_v_mesh}"
      v_mesh_use_low_res="${top_lidar_v_mesh_use_low_res}"
      color="${top_lidar_color}"
      use_c_mesh="${top_lidar_use_c_mesh}"
      c_mesh_use_low_res="${top_lidar_c_mesh_use_low_res}"
      joint_parent_fr_root_fr="0.0 0.0 ${top_platform_size_z} 0.0 0.0 0.0"
      sim_lidar_enabled="${use_sim_mode and top_lidar_sim_enabled}"
      sim_lidar_always_on="${top_lidar_sim_always_on}"
      sim_lidar_visualize="${top_lidar_sim_visualize}"
      sim_lidar_update_rate="${top_lidar_sim_update_rate}"
      sim_lidar_hor_fov_deg="${top_lidar_sim_hor_fov_deg}"
      sim_lidar_hor_res_deg="${top_lidar_sim_hor_res_deg}"
      sim_lidar_ver_fov_deg="${top_lidar_sim_ver_fov_deg}"
      sim_lidar_ver_res_deg="${top_lidar_sim_ver_res_deg}"
      sim_lidar_dist_span="${top_lidar_sim_dist_span}"
      sim_lidar_gaussian_noise="${top_lidar_sim_gaussian_noise}"
      sim_imu_enabled="${use_sim_mode and top_lidar_imu_sim_enabled}"
      sim_imu_use_gravity="${top_lidar_imu_sim_use_gravity}"
      sim_imu_always_on="${top_lidar_imu_sim_always_on}"
      sim_imu_update_rate="${top_lidar_imu_sim_update_rate}"
      sim_imu_ang_vel_gaussian_noise="${top_lidar_imu_sim_ang_vel_gaussian_noise}"
      sim_imu_ang_vel_gaussian_noise_bias="${top_lidar_imu_sim_ang_vel_gaussian_noise_bias}"
      sim_imu_ang_vel_gaussian_noise_dynamic_bias="${top_lidar_imu_sim_ang_vel_gaussian_noise_dynamic_bias}"
      sim_imu_lin_acc_gaussian_noise="${top_lidar_imu_sim_lin_acc_gaussian_noise}"
      sim_imu_lin_acc_gaussian_noise_bias="${top_lidar_imu_sim_lin_acc_gaussian_noise_bias}"
      sim_imu_lin_acc_gaussian_noise_dynamic_bias="${top_lidar_imu_sim_lin_acc_gaussian_noise_dynamic_bias}"
      sim_imu_use_orientation="${top_lidar_imu_sim_use_orientation}"
      namespace="${robot_namespace}"
      sim_lidar_base_topic="${top_lidar_sim_base_topic}"
      sim_imu_topic="${top_lidar_imu_sim_topic}"/>

  <!-- ===================================================================== -->
  <!-- FORK CAMERA: REALSENSE D435 -->
  <!-- ===================================================================== -->

  <!--
  In a physical RealSense D435, depth is estimated from the stereo pair captured by the two
  infrared cameras.
  In this simulation model, the color and depth streams are generated by a single 'rgbd_camera'
  Gazebo plugin, while the two infrared streams are generated by two separate 'camera' Gazebo
  plugins.
  This means, the frame from which the image and depth_image topics are published is the same, and
  it is different from the frames of the two infrared cameras.
  The frame specified in the published messages is `depth_frame`.
  The shared optical frame for the color and depth streams is the `depth_optical_frame`.
  -->
  <xacro:property name="fork_camera_rgbd_sim_cfg"   value="${sim_cfg.get('fork_camera_rgbd', dict())}"/>
  <xacro:property name="fork_camera_infra1_sim_cfg" value="${sim_cfg.get('fork_camera_infra1', dict())}"/>
  <xacro:property name="fork_camera_infra2_sim_cfg" value="${sim_cfg.get('fork_camera_infra2', dict())}"/>

  <!-- Set properties for the `rgbd_camera` Gazebo plugin associated to the fork camera. -->
  <xacro:set_props_plugin_camera_rgbd prop_prefix="fork_camera_rgbd_sim"
                                      sim_cfg="${fork_camera_rgbd_sim_cfg}"/>

  <!-- Set properties for the `camera` Gazebo plugin associated to the first infrared camera in the fork camera. -->
  <xacro:set_props_plugin_camera prop_prefix="fork_camera_infra1_sim"
                                 sim_cfg="${fork_camera_infra1_sim_cfg}"/>

  <!-- Set properties for the `camera` Gazebo plugin associated to the second infrared camera in the fork camera. -->
  <xacro:set_props_plugin_camera prop_prefix="fork_camera_infra2_sim"
                                 sim_cfg="${fork_camera_infra2_sim_cfg}"/>

  <!--
  This camera is mounted on `${robot_prefix}${fork_name}_carriage_link`.
  The root frame for the realsense_d435 camera is ${prefix}${name}_bottom_screw_frame.
  The frame of the mesh is located at its center.
  Sizes of the mesh are: (size_x = 0.025053 m, size_y = 0.089909 m, size_z = 0.025000 m)
  The frame of the mesh is located, w.r.t ${prefix}${name}_bottom_screw_frame, at
  (x = 0.002375 m, y = 0 m, z = 0.0125 m, R = 0 rad, P = 0 rad, Y = 0 rad).
  The bottom face of the mesh is touching the root frame of the camera.
  Therefore, x_min = 0.002375 - (0.025053/2) m = -0.0101515 m.
  Therefore, we have to move the root frame of the camera 0.0101515 m in the positive x-axis of
  fork's root frame to have the back face of the camera aligned with the back face of the fork.
  And, since the height of the union body that joins the tines of the fork is 6 cm, the root frame
  of the camera has to be located at 6 cm in the z-axis of the fork's root frame.
  -->
  <xacro:property name="fork_rgbd_mount_x" value="0.0101515"/>
  <xacro:property name="fork_rgbd_mount_y" value="0"/>
  <xacro:property name="fork_rgbd_mount_z" value="${tine_size_z}"/>

  <xacro:realsense_d435_rgbd name="fork_camera"
                             prefix="${robot_prefix}"
                             namespace="${robot_namespace}"
                             parent_frame="${robot_prefix}${fork_name}_carriage_link"
                             use_visual="${fork_rgbd_use_visual}"
                             use_collision="${fork_rgbd_use_collision}"
                             use_inertial="${fork_rgbd_use_inertial}"
                             use_v_mesh="${fork_rgbd_use_v_mesh}"
                             color="${fork_rgbd_color}"
                             use_c_mesh="${fork_rgbd_use_c_mesh}"
                             joint_parent_fr_root_fr="${fork_rgbd_mount_x} ${fork_rgbd_mount_y} ${fork_rgbd_mount_z} 0 0 0"
                             use_sensor_frames_and_joints="${use_sim_mode}"
                             sim_rgbd_enabled="${use_sim_mode and fork_camera_rgbd_sim_enabled}"
                             sim_rgbd_use_gravity="${fork_camera_rgbd_sim_use_gravity}"
                             sim_rgbd_always_on="${fork_camera_rgbd_sim_always_on}"
                             sim_rgbd_visualize="${fork_camera_rgbd_sim_visualize}"
                             sim_rgbd_enable_metrics="${fork_camera_rgbd_sim_enable_metrics}"
                             sim_rgbd_save="${fork_camera_rgbd_sim_save}"
                             sim_rgbd_triggered="${fork_camera_rgbd_sim_triggered}"
                             sim_rgbd_visible_mask="${fork_camera_rgbd_sim_visible_mask}"
                             sim_rgbd_clip="${fork_camera_rgbd_sim_clip}"
                             sim_rgbd_depth_clip="${fork_camera_rgbd_sim_depth_clip}"
                             sim_rgbd_update_rate="${fork_camera_rgbd_sim_update_rate}"
                             sim_rgbd_image="${fork_camera_rgbd_sim_image}"
                             sim_rgbd_lens_single_elements="${fork_camera_rgbd_sim_lens_single_elements}"
                             sim_rgbd_lens_custom_function="${fork_camera_rgbd_sim_lens_custom_function}"
                             sim_rgbd_lens_intrinsics="${fork_camera_rgbd_sim_lens_intrinsics}"
                             sim_rgbd_lens_xy_skew="${fork_camera_rgbd_sim_lens_xy_skew}"
                             sim_rgbd_lens_projection="${fork_camera_rgbd_sim_lens_projection}"
                             sim_rgbd_distortion_k_p="${fork_camera_rgbd_sim_distortion_k_p}"
                             sim_rgbd_distortion_center="${fork_camera_rgbd_sim_distortion_center}"
                             sim_rgbd_gaussian_noise="${fork_camera_rgbd_sim_gaussian_noise}"
                             sim_infra1_enabled="${use_sim_mode and fork_camera_infra1_sim_enabled}"
                             sim_infra1_use_gravity="${fork_camera_infra1_sim_use_gravity}"
                             sim_infra1_always_on="${fork_camera_infra1_sim_always_on}"
                             sim_infra1_visualize="${fork_camera_infra1_sim_visualize}"
                             sim_infra1_enable_metrics="${fork_camera_infra1_sim_enable_metrics}"
                             sim_infra1_save="${fork_camera_infra1_sim_save}"
                             sim_infra1_triggered="${fork_camera_infra1_sim_triggered}"
                             sim_infra1_visible_mask="${fork_camera_infra1_sim_visible_mask}"
                             sim_infra1_clip="${fork_camera_infra1_sim_clip}"
                             sim_infra1_update_rate="${fork_camera_infra1_sim_update_rate}"
                             sim_infra1_image="${fork_camera_infra1_sim_image}"
                             sim_infra1_lens_single_elements="${fork_camera_infra1_sim_lens_single_elements}"
                             sim_infra1_lens_custom_function="${fork_camera_infra1_sim_lens_custom_function}"
                             sim_infra1_lens_intrinsics="${fork_camera_infra1_sim_lens_intrinsics}"
                             sim_infra1_lens_xy_skew="${fork_camera_infra1_sim_lens_xy_skew}"
                             sim_infra1_lens_projection="${fork_camera_infra1_sim_lens_projection}"
                             sim_infra1_distortion_k_p="${fork_camera_infra1_sim_distortion_k_p}"
                             sim_infra1_distortion_center="${fork_camera_infra1_sim_distortion_center}"
                             sim_infra1_gaussian_noise="${fork_camera_infra1_sim_gaussian_noise}"
                             sim_infra2_enabled="${use_sim_mode and fork_camera_infra2_sim_enabled}"
                             sim_infra2_use_gravity="${fork_camera_infra2_sim_use_gravity}"
                             sim_infra2_always_on="${fork_camera_infra2_sim_always_on}"
                             sim_infra2_visualize="${fork_camera_infra2_sim_visualize}"
                             sim_infra2_enable_metrics="${fork_camera_infra2_sim_enable_metrics}"
                             sim_infra2_save="${fork_camera_infra2_sim_save}"
                             sim_infra2_triggered="${fork_camera_infra2_sim_triggered}"
                             sim_infra2_visible_mask="${fork_camera_infra2_sim_visible_mask}"
                             sim_infra2_clip="${fork_camera_infra2_sim_clip}"
                             sim_infra2_update_rate="${fork_camera_infra2_sim_update_rate}"
                             sim_infra2_image="${fork_camera_infra2_sim_image}"
                             sim_infra2_lens_single_elements="${fork_camera_infra2_sim_lens_single_elements}"
                             sim_infra2_lens_custom_function="${fork_camera_infra2_sim_lens_custom_function}"
                             sim_infra2_lens_intrinsics="${fork_camera_infra2_sim_lens_intrinsics}"
                             sim_infra2_lens_xy_skew="${fork_camera_infra2_sim_lens_xy_skew}"
                             sim_infra2_lens_projection="${fork_camera_infra2_sim_lens_projection}"
                             sim_infra2_distortion_k_p="${fork_camera_infra2_sim_distortion_k_p}"
                             sim_infra2_distortion_center="${fork_camera_infra2_sim_distortion_center}"
                             sim_infra2_gaussian_noise="${fork_camera_infra2_sim_gaussian_noise}"
                             sim_rgbd_base_topic="${fork_camera_rgbd_sim_base_topic}"
                             sim_rgbd_trigger_topic="${fork_camera_rgbd_sim_trigger_topic}"
                             sim_infra1_image_topic="${fork_camera_infra1_sim_topic}"
                             sim_infra1_camera_info_topic="${fork_camera_infra1_sim_info_topic}"
                             sim_infra1_trigger_topic="${fork_camera_infra1_sim_trigger_topic}"
                             sim_infra2_image_topic="${fork_camera_infra2_sim_topic}"
                             sim_infra2_camera_info_topic="${fork_camera_infra2_sim_info_topic}"
                             sim_infra2_trigger_topic="${fork_camera_infra2_sim_trigger_topic}"/>

  <!--
  The tine cameras are mounted near the front opening of each tine.
  The x position uses the reference tine length and the fixed D435 body offset
  used above. The y position places each camera at the center of its tine.
  -->
  <!-- ===================================================================== -->
  <!-- LEFT TINE CAMERA: REALSENSE D435 -->
  <!-- ===================================================================== -->

  <xacro:property name="left_tine_rgbd_use_visual"       value="$(arg left_tine_rgbd_use_visual)"/>
  <xacro:property name="left_tine_rgbd_use_collision"    value="$(arg left_tine_rgbd_use_collision)"/>
  <xacro:property name="left_tine_rgbd_use_inertial"     value="$(arg left_tine_rgbd_use_inertial)"/>
  <xacro:property name="left_tine_rgbd_use_v_mesh"       value="$(arg left_tine_rgbd_use_v_mesh)"/>
  <xacro:property name="left_tine_rgbd_color"            value="$(arg left_tine_rgbd_color)"/>
  <xacro:property name="left_tine_rgbd_use_c_mesh"       value="$(arg left_tine_rgbd_use_c_mesh)"/>
  <xacro:property name="left_tine_camera_rgbd_sim_cfg"   value="${sim_cfg.get('left_tine_camera_rgbd', dict())}"/>
  <xacro:property name="left_tine_camera_infra1_sim_cfg" value="${sim_cfg.get('left_tine_camera_infra1', dict())}"/>
  <xacro:property name="left_tine_camera_infra2_sim_cfg" value="${sim_cfg.get('left_tine_camera_infra2', dict())}"/>

  <!-- Set properties for the `rgbd_camera` Gazebo plugin associated to the left tine camera. -->
  <xacro:set_props_plugin_camera_rgbd prop_prefix="left_tine_camera_rgbd_sim"
                                      sim_cfg="${left_tine_camera_rgbd_sim_cfg}"/>

  <!-- Set properties for the first infrared Gazebo plugin in the left tine camera. -->
  <xacro:set_props_plugin_camera prop_prefix="left_tine_camera_infra1_sim"
                                 sim_cfg="${left_tine_camera_infra1_sim_cfg}"/>

  <!-- Set properties for the second infrared Gazebo plugin in the left tine camera. -->
  <xacro:set_props_plugin_camera prop_prefix="left_tine_camera_infra2_sim"
                                 sim_cfg="${left_tine_camera_infra2_sim_cfg}"/>

  <!--
  The left tine camera is mounted in the carriage frame, not in `${robot_prefix}${base_name}_link`.
  The D435 front face is 0.0149 m in front of its root frame.
  tine_size_x - 0.0149 - 0.01 places the camera 1 cm behind the front opening of the left tine.
  -->
  <xacro:property name="left_tine_rgbd_mount_x"
                  value="${fork_carriage_len_x + tine_size_x - 0.0149 - 0.01}"/>

  <xacro:property name="left_tine_rgbd_mount_y"
                  value="${0.5*(tine_separation + tine_size_y)}"/>

  <xacro:property name="left_tine_rgbd_mount_z" value="0.001"/>

  <xacro:realsense_d435_rgbd name="left_tine_camera"
                             prefix="${robot_prefix}"
                             namespace="${robot_namespace}"
                             parent_frame="${robot_prefix}${fork_name}_carriage_link"
                             use_visual="${left_tine_rgbd_use_visual}"
                             use_collision="${left_tine_rgbd_use_collision}"
                             use_inertial="${left_tine_rgbd_use_inertial}"
                             use_v_mesh="${left_tine_rgbd_use_v_mesh}"
                             color="${left_tine_rgbd_color}"
                             use_c_mesh="${left_tine_rgbd_use_c_mesh}"
                             joint_parent_fr_root_fr="${left_tine_rgbd_mount_x} ${left_tine_rgbd_mount_y} ${left_tine_rgbd_mount_z} 0.0 0.0 0.0"
                             use_sensor_frames_and_joints="${use_sim_mode}"
                             sim_rgbd_enabled="${use_sim_mode and left_tine_camera_rgbd_sim_enabled}"
                             sim_rgbd_use_gravity="${left_tine_camera_rgbd_sim_use_gravity}"
                             sim_rgbd_always_on="${left_tine_camera_rgbd_sim_always_on}"
                             sim_rgbd_visualize="${left_tine_camera_rgbd_sim_visualize}"
                             sim_rgbd_enable_metrics="${left_tine_camera_rgbd_sim_enable_metrics}"
                             sim_rgbd_save="${left_tine_camera_rgbd_sim_save}"
                             sim_rgbd_triggered="${left_tine_camera_rgbd_sim_triggered}"
                             sim_rgbd_visible_mask="${left_tine_camera_rgbd_sim_visible_mask}"
                             sim_rgbd_clip="${left_tine_camera_rgbd_sim_clip}"
                             sim_rgbd_depth_clip="${left_tine_camera_rgbd_sim_depth_clip}"
                             sim_rgbd_update_rate="${left_tine_camera_rgbd_sim_update_rate}"
                             sim_rgbd_image="${left_tine_camera_rgbd_sim_image}"
                             sim_rgbd_lens_single_elements="${left_tine_camera_rgbd_sim_lens_single_elements}"
                             sim_rgbd_lens_custom_function="${left_tine_camera_rgbd_sim_lens_custom_function}"
                             sim_rgbd_lens_intrinsics="${left_tine_camera_rgbd_sim_lens_intrinsics}"
                             sim_rgbd_lens_xy_skew="${left_tine_camera_rgbd_sim_lens_xy_skew}"
                             sim_rgbd_lens_projection="${left_tine_camera_rgbd_sim_lens_projection}"
                             sim_rgbd_distortion_k_p="${left_tine_camera_rgbd_sim_distortion_k_p}"
                             sim_rgbd_distortion_center="${left_tine_camera_rgbd_sim_distortion_center}"
                             sim_rgbd_gaussian_noise="${left_tine_camera_rgbd_sim_gaussian_noise}"
                             sim_infra1_enabled="${use_sim_mode and left_tine_camera_infra1_sim_enabled}"
                             sim_infra1_use_gravity="${left_tine_camera_infra1_sim_use_gravity}"
                             sim_infra1_always_on="${left_tine_camera_infra1_sim_always_on}"
                             sim_infra1_visualize="${left_tine_camera_infra1_sim_visualize}"
                             sim_infra1_enable_metrics="${left_tine_camera_infra1_sim_enable_metrics}"
                             sim_infra1_save="${left_tine_camera_infra1_sim_save}"
                             sim_infra1_triggered="${left_tine_camera_infra1_sim_triggered}"
                             sim_infra1_visible_mask="${left_tine_camera_infra1_sim_visible_mask}"
                             sim_infra1_clip="${left_tine_camera_infra1_sim_clip}"
                             sim_infra1_update_rate="${left_tine_camera_infra1_sim_update_rate}"
                             sim_infra1_image="${left_tine_camera_infra1_sim_image}"
                             sim_infra1_lens_single_elements="${left_tine_camera_infra1_sim_lens_single_elements}"
                             sim_infra1_lens_custom_function="${left_tine_camera_infra1_sim_lens_custom_function}"
                             sim_infra1_lens_intrinsics="${left_tine_camera_infra1_sim_lens_intrinsics}"
                             sim_infra1_lens_xy_skew="${left_tine_camera_infra1_sim_lens_xy_skew}"
                             sim_infra1_lens_projection="${left_tine_camera_infra1_sim_lens_projection}"
                             sim_infra1_distortion_k_p="${left_tine_camera_infra1_sim_distortion_k_p}"
                             sim_infra1_distortion_center="${left_tine_camera_infra1_sim_distortion_center}"
                             sim_infra1_gaussian_noise="${left_tine_camera_infra1_sim_gaussian_noise}"
                             sim_infra2_enabled="${use_sim_mode and left_tine_camera_infra2_sim_enabled}"
                             sim_infra2_use_gravity="${left_tine_camera_infra2_sim_use_gravity}"
                             sim_infra2_always_on="${left_tine_camera_infra2_sim_always_on}"
                             sim_infra2_visualize="${left_tine_camera_infra2_sim_visualize}"
                             sim_infra2_enable_metrics="${left_tine_camera_infra2_sim_enable_metrics}"
                             sim_infra2_save="${left_tine_camera_infra2_sim_save}"
                             sim_infra2_triggered="${left_tine_camera_infra2_sim_triggered}"
                             sim_infra2_visible_mask="${left_tine_camera_infra2_sim_visible_mask}"
                             sim_infra2_clip="${left_tine_camera_infra2_sim_clip}"
                             sim_infra2_update_rate="${left_tine_camera_infra2_sim_update_rate}"
                             sim_infra2_image="${left_tine_camera_infra2_sim_image}"
                             sim_infra2_lens_single_elements="${left_tine_camera_infra2_sim_lens_single_elements}"
                             sim_infra2_lens_custom_function="${left_tine_camera_infra2_sim_lens_custom_function}"
                             sim_infra2_lens_intrinsics="${left_tine_camera_infra2_sim_lens_intrinsics}"
                             sim_infra2_lens_xy_skew="${left_tine_camera_infra2_sim_lens_xy_skew}"
                             sim_infra2_lens_projection="${left_tine_camera_infra2_sim_lens_projection}"
                             sim_infra2_distortion_k_p="${left_tine_camera_infra2_sim_distortion_k_p}"
                             sim_infra2_distortion_center="${left_tine_camera_infra2_sim_distortion_center}"
                             sim_infra2_gaussian_noise="${left_tine_camera_infra2_sim_gaussian_noise}"
                             sim_rgbd_base_topic="${left_tine_camera_rgbd_sim_base_topic}"
                             sim_rgbd_trigger_topic="${left_tine_camera_rgbd_sim_trigger_topic}"
                             sim_infra1_image_topic="${left_tine_camera_infra1_sim_topic}"
                             sim_infra1_camera_info_topic="${left_tine_camera_infra1_sim_info_topic}"
                             sim_infra1_trigger_topic="${left_tine_camera_infra1_sim_trigger_topic}"
                             sim_infra2_image_topic="${left_tine_camera_infra2_sim_topic}"
                             sim_infra2_camera_info_topic="${left_tine_camera_infra2_sim_info_topic}"
                             sim_infra2_trigger_topic="${left_tine_camera_infra2_sim_trigger_topic}"/>

  <!-- ===================================================================== -->
  <!-- RIGHT TINE CAMERA: REALSENSE D435 -->
  <!-- ===================================================================== -->

  <xacro:property name="right_tine_rgbd_use_visual"       value="$(arg right_tine_rgbd_use_visual)"/>
  <xacro:property name="right_tine_rgbd_use_collision"    value="$(arg right_tine_rgbd_use_collision)"/>
  <xacro:property name="right_tine_rgbd_use_inertial"     value="$(arg right_tine_rgbd_use_inertial)"/>
  <xacro:property name="right_tine_rgbd_use_v_mesh"       value="$(arg right_tine_rgbd_use_v_mesh)"/>
  <xacro:property name="right_tine_rgbd_color"            value="$(arg right_tine_rgbd_color)"/>
  <xacro:property name="right_tine_rgbd_use_c_mesh"       value="$(arg right_tine_rgbd_use_c_mesh)"/>
  <xacro:property name="right_tine_camera_rgbd_sim_cfg"   value="${sim_cfg.get('right_tine_camera_rgbd', dict())}"/>
  <xacro:property name="right_tine_camera_infra1_sim_cfg" value="${sim_cfg.get('right_tine_camera_infra1', dict())}"/>
  <xacro:property name="right_tine_camera_infra2_sim_cfg" value="${sim_cfg.get('right_tine_camera_infra2', dict())}"/>

  <!-- Set properties for the `rgbd_camera` Gazebo plugin associated to the right tine camera. -->
  <xacro:set_props_plugin_camera_rgbd prop_prefix="right_tine_camera_rgbd_sim"
                                      sim_cfg="${right_tine_camera_rgbd_sim_cfg}"/>

  <!-- Set properties for the first infrared Gazebo plugin in the right tine camera. -->
  <xacro:set_props_plugin_camera prop_prefix="right_tine_camera_infra1_sim"
                                 sim_cfg="${right_tine_camera_infra1_sim_cfg}"/>

  <!-- Set properties for the second infrared Gazebo plugin in the right tine camera. -->
  <xacro:set_props_plugin_camera prop_prefix="right_tine_camera_infra2_sim"
                                 sim_cfg="${right_tine_camera_infra2_sim_cfg}"/>

  <!--
  The right tine camera uses the same x and z coordinates as the left tine camera.
  The y coordinate is mirrored around the carriage center line.
  -->
  <xacro:property name="right_tine_rgbd_mount_x" value="${left_tine_rgbd_mount_x}"/>
  <xacro:property name="right_tine_rgbd_mount_y" value="${-left_tine_rgbd_mount_y}"/>
  <xacro:property name="right_tine_rgbd_mount_z" value="${left_tine_rgbd_mount_z}"/>

  <xacro:realsense_d435_rgbd name="right_tine_camera"
                             prefix="${robot_prefix}"
                             namespace="${robot_namespace}"
                             parent_frame="${robot_prefix}${fork_name}_carriage_link"
                             use_visual="${right_tine_rgbd_use_visual}"
                             use_collision="${right_tine_rgbd_use_collision}"
                             use_inertial="${right_tine_rgbd_use_inertial}"
                             use_v_mesh="${right_tine_rgbd_use_v_mesh}"
                             color="${right_tine_rgbd_color}"
                             use_c_mesh="${right_tine_rgbd_use_c_mesh}"
                             joint_parent_fr_root_fr="${right_tine_rgbd_mount_x} ${right_tine_rgbd_mount_y} ${right_tine_rgbd_mount_z} 0.0 0.0 0.0"
                             use_sensor_frames_and_joints="${use_sim_mode}"
                             sim_rgbd_enabled="${use_sim_mode and right_tine_camera_rgbd_sim_enabled}"
                             sim_rgbd_use_gravity="${right_tine_camera_rgbd_sim_use_gravity}"
                             sim_rgbd_always_on="${right_tine_camera_rgbd_sim_always_on}"
                             sim_rgbd_visualize="${right_tine_camera_rgbd_sim_visualize}"
                             sim_rgbd_enable_metrics="${right_tine_camera_rgbd_sim_enable_metrics}"
                             sim_rgbd_save="${right_tine_camera_rgbd_sim_save}"
                             sim_rgbd_triggered="${right_tine_camera_rgbd_sim_triggered}"
                             sim_rgbd_visible_mask="${right_tine_camera_rgbd_sim_visible_mask}"
                             sim_rgbd_clip="${right_tine_camera_rgbd_sim_clip}"
                             sim_rgbd_depth_clip="${right_tine_camera_rgbd_sim_depth_clip}"
                             sim_rgbd_update_rate="${right_tine_camera_rgbd_sim_update_rate}"
                             sim_rgbd_image="${right_tine_camera_rgbd_sim_image}"
                             sim_rgbd_lens_single_elements="${right_tine_camera_rgbd_sim_lens_single_elements}"
                             sim_rgbd_lens_custom_function="${right_tine_camera_rgbd_sim_lens_custom_function}"
                             sim_rgbd_lens_intrinsics="${right_tine_camera_rgbd_sim_lens_intrinsics}"
                             sim_rgbd_lens_xy_skew="${right_tine_camera_rgbd_sim_lens_xy_skew}"
                             sim_rgbd_lens_projection="${right_tine_camera_rgbd_sim_lens_projection}"
                             sim_rgbd_distortion_k_p="${right_tine_camera_rgbd_sim_distortion_k_p}"
                             sim_rgbd_distortion_center="${right_tine_camera_rgbd_sim_distortion_center}"
                             sim_rgbd_gaussian_noise="${right_tine_camera_rgbd_sim_gaussian_noise}"
                             sim_infra1_enabled="${use_sim_mode and right_tine_camera_infra1_sim_enabled}"
                             sim_infra1_use_gravity="${right_tine_camera_infra1_sim_use_gravity}"
                             sim_infra1_always_on="${right_tine_camera_infra1_sim_always_on}"
                             sim_infra1_visualize="${right_tine_camera_infra1_sim_visualize}"
                             sim_infra1_enable_metrics="${right_tine_camera_infra1_sim_enable_metrics}"
                             sim_infra1_save="${right_tine_camera_infra1_sim_save}"
                             sim_infra1_triggered="${right_tine_camera_infra1_sim_triggered}"
                             sim_infra1_visible_mask="${right_tine_camera_infra1_sim_visible_mask}"
                             sim_infra1_clip="${right_tine_camera_infra1_sim_clip}"
                             sim_infra1_update_rate="${right_tine_camera_infra1_sim_update_rate}"
                             sim_infra1_image="${right_tine_camera_infra1_sim_image}"
                             sim_infra1_lens_single_elements="${right_tine_camera_infra1_sim_lens_single_elements}"
                             sim_infra1_lens_custom_function="${right_tine_camera_infra1_sim_lens_custom_function}"
                             sim_infra1_lens_intrinsics="${right_tine_camera_infra1_sim_lens_intrinsics}"
                             sim_infra1_lens_xy_skew="${right_tine_camera_infra1_sim_lens_xy_skew}"
                             sim_infra1_lens_projection="${right_tine_camera_infra1_sim_lens_projection}"
                             sim_infra1_distortion_k_p="${right_tine_camera_infra1_sim_distortion_k_p}"
                             sim_infra1_distortion_center="${right_tine_camera_infra1_sim_distortion_center}"
                             sim_infra1_gaussian_noise="${right_tine_camera_infra1_sim_gaussian_noise}"
                             sim_infra2_enabled="${use_sim_mode and right_tine_camera_infra2_sim_enabled}"
                             sim_infra2_use_gravity="${right_tine_camera_infra2_sim_use_gravity}"
                             sim_infra2_always_on="${right_tine_camera_infra2_sim_always_on}"
                             sim_infra2_visualize="${right_tine_camera_infra2_sim_visualize}"
                             sim_infra2_enable_metrics="${right_tine_camera_infra2_sim_enable_metrics}"
                             sim_infra2_save="${right_tine_camera_infra2_sim_save}"
                             sim_infra2_triggered="${right_tine_camera_infra2_sim_triggered}"
                             sim_infra2_visible_mask="${right_tine_camera_infra2_sim_visible_mask}"
                             sim_infra2_clip="${right_tine_camera_infra2_sim_clip}"
                             sim_infra2_update_rate="${right_tine_camera_infra2_sim_update_rate}"
                             sim_infra2_image="${right_tine_camera_infra2_sim_image}"
                             sim_infra2_lens_single_elements="${right_tine_camera_infra2_sim_lens_single_elements}"
                             sim_infra2_lens_custom_function="${right_tine_camera_infra2_sim_lens_custom_function}"
                             sim_infra2_lens_intrinsics="${right_tine_camera_infra2_sim_lens_intrinsics}"
                             sim_infra2_lens_xy_skew="${right_tine_camera_infra2_sim_lens_xy_skew}"
                             sim_infra2_lens_projection="${right_tine_camera_infra2_sim_lens_projection}"
                             sim_infra2_distortion_k_p="${right_tine_camera_infra2_sim_distortion_k_p}"
                             sim_infra2_distortion_center="${right_tine_camera_infra2_sim_distortion_center}"
                             sim_infra2_gaussian_noise="${right_tine_camera_infra2_sim_gaussian_noise}"
                             sim_rgbd_base_topic="${right_tine_camera_rgbd_sim_base_topic}"
                             sim_rgbd_trigger_topic="${right_tine_camera_rgbd_sim_trigger_topic}"
                             sim_infra1_image_topic="${right_tine_camera_infra1_sim_topic}"
                             sim_infra1_camera_info_topic="${right_tine_camera_infra1_sim_info_topic}"
                             sim_infra1_trigger_topic="${right_tine_camera_infra1_sim_trigger_topic}"
                             sim_infra2_image_topic="${right_tine_camera_infra2_sim_topic}"
                             sim_infra2_camera_info_topic="${right_tine_camera_infra2_sim_info_topic}"
                             sim_infra2_trigger_topic="${right_tine_camera_infra2_sim_trigger_topic}"/>

  <xacro:if value="${use_sim_mode}">
    <gazebo>
      <!--
      Define a 'JointStatePublisher' Gazebo plugin to report the states of the joints.
      -->
      <xacro:property name="joint_state_publisher_sim_cfg"
                      value="${sim_cfg.get('joint_state_publisher', dict())}"/>

      <xacro:if value="${joint_state_publisher_sim_cfg.get('enabled', False)}">
        <xacro:property name="js_topic"
                        value="${joint_state_publisher_sim_cfg.get('topic', '')}"/>

        <!-- No topic, no Gazebo plugin -->
        <xacro:if value="${js_topic != ''}">
          <xacro:resolve_topic prop_id="resolved_js_topic"
                               topic="${js_topic}"
                               namespace="${robot_namespace}"/>

          <xacro:plugin_joint_state_publisher topic="${resolved_js_topic}">
            <joint_names>
              <joint_name>${robot_prefix}${fork_name}_carriage_joint</joint_name>
              <joint_name>${robot_prefix}${steerable_wheel_0_name}_steering_joint</joint_name>
              <joint_name>${robot_prefix}${steerable_wheel_0_name}_rotation_joint</joint_name>
              <joint_name>${robot_prefix}${steerable_wheel_1_name}_steering_joint</joint_name>
              <joint_name>${robot_prefix}${steerable_wheel_1_name}_rotation_joint</joint_name>
              <joint_name>${robot_prefix}${steerable_wheel_2_name}_steering_joint</joint_name>
              <joint_name>${robot_prefix}${steerable_wheel_2_name}_rotation_joint</joint_name>
            </joint_names>
          </xacro:plugin_joint_state_publisher>
        </xacro:if>
      </xacro:if>
    </gazebo>
  </xacro:if>
</robot>
